# E28 draft-depth-7 candidate: a standalone TP4_ENV applied on top of the complete E27c recipe
# (scripts/node/reference/baseline-20260925-e27c.env), at six sequences like the E27c reference.
# It was promoted inside E28b on 2026-09-25, so it refuses the current default and is the
# record of the measured candidate.
# Enter: down with the overlay that started the running stack, then deploy/up with this one.
# Return: down with this overlay, then deploy/up with no TP4_ENV. Use the same TP4_ENV for
# every command in the window; never change CONTAINER.
# The DFlash2 drafter is trained with blocks of 8 (up to seven draft tokens). E28 lets a single
# request draft seven tokens instead of five: SPEC_TOKENS=7, the per-batch table becomes
# [[1,1,7],[2,6,3]] and the adaptive high state becomes 7. Batches of 2-6 keep three tokens and
# the adaptive low state keeps three. The CUDA graph capture limit stays at the E27c value of 72,
# so the captured set does not grow. Weights, drafter and cache namespace are unchanged.
if [ "${IMAGE-}" != "ghcr.io/fujitsupolycom/sparkring-glm53-sparkcache@sha256:0d4029b3b7023cf32c37ac20279469c9a2ee16a057f25aae3bcfee9ee5fb660f" ] \
   || [ "${IMAGE_ID-}" != "sha256:5e32aaa1bbe3559e81db7706ed4286248f18d27cfdb186f6b851bf786eb43075" ] \
   || [ "${SPARKCACHE_MODE-}" != on ] \
   || [ "${SPARK_MHC_PREFILL_SHARD-}" != 1 ] \
   || [ "${MAX_MODEL_LEN-}" != 262144 ] \
   || [ "${MAX_NUM_SEQS-}" != 6 ] \
   || [ "${BATCHED_TOKENS-}" != 8192 ] \
   || [ "${SPEC_TOKENS-}" != 5 ] \
   || [ "${SPEC_EXTRA_JSON-}" != '"num_speculative_tokens_per_batch_size":[[1,1,5],[2,6,3]],"kv_cache_dtype":"fp8_e4m3"' ]; then
  echo "E28 requires the accepted E27c image, mHC prefill sharding, 262144 context, max-num-seqs 6, an 8192-token batch and the five/three draft table" >&2
  return 1
fi

[ "${SPARKCACHE_CONFIG_SHA256-}" = f7d8989486907766c8df7ceaf67731fd2ec95e3bf474a6f63bb4303e41fbe4bc ] \
  || { echo "E28 requires the accepted E22b cache config" >&2; return 1; }

[[ "$EXTRA_DOCKER_ENV" == *"/experiments/e03/queued-cadence/scheduler.py:"* &&
   "$EXTRA_DOCKER_ENV" == *" -e VLLM_E27B_SHORT_PREFILL_TOKENS=2048"* &&
   "$EXTRA_DOCKER_ENV" == *" -e VLLM_E27C_CADENCE_WHEN_QUEUED=1"* &&
   "$EXTRA_DOCKER_ENV" == *" -e VLLM_ADAPTIVE_K_MODE=batch-uniform"* &&
   "$EXTRA_DOCKER_ENV" == *" -e VLLM_ADAPTIVE_K_RESPECT_DRAFT_BUDGET=1"* &&
   "$EXTRA_DOCKER_ENV" != *VLLM_ADAPTIVE_K_HI* &&
   "$EXTRA_DOCKER_ENV" != *VLLM_ADAPTIVE_K_LO* ]] \
  || { echo "E28 requires the E27c scheduler, the batch-uniform draft-budget policy and default adaptive bounds" >&2; return 1; }

read -r -a _E28_ARGS <<<"${EXTRA_VLLM_ARGS-}"
_E28_SCHED=0
for _E28_ARG in "${_E28_ARGS[@]}"; do
  case "$_E28_ARG" in
    --compilation-config*|-cc*|-O*)
      echo "E28 refuses an existing compilation configuration" >&2
      unset _E28_ARGS _E28_ARG _E28_SCHED
      return 1 ;;
    adaptive_k_scheduler.AdaptiveKScheduler) _E28_SCHED=$((_E28_SCHED + 1)) ;;
  esac
done
[ "$_E28_SCHED" -eq 1 ] && [[ " ${EXTRA_VLLM_ARGS-} " == *" --prefill-schedule-interval 8 "* ]] || {
  echo "E28 requires the adaptive-k scheduler class once and the E27 prefill cadence" >&2
  unset _E28_ARGS _E28_ARG _E28_SCHED
  return 1
}
unset _E28_ARGS _E28_ARG _E28_SCHED

SPEC_TOKENS=7
SPEC_EXTRA_JSON='"num_speculative_tokens_per_batch_size":[[1,1,7],[2,6,3]],"kv_cache_dtype":"fp8_e4m3"'
EXTRA_DOCKER_ENV+=' -e VLLM_ADAPTIVE_K_HI=7'
EXTRA_VLLM_ARGS+=' --compilation-config={"max_cudagraph_capture_size":72}'
