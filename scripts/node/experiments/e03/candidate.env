# E03 candidate derived from the September 19 base; no lifecycle action on source.
# Use this same TP4_ENV for deploy, down, up and all commands in the window.
# Rollback: coordinated down with this overlay, then deploy/up without TP4_ENV;
# retain both cache namespaces. A later transition needs its own authorization.
SPARK_MHC_PREFILL_SHARD=1
SPARKCACHE_CONFIG='$HOME/tp4/experiments/e03/kv-transfer-config.json'
SPARKCACHE_CONFIG_SHA256=9a0520e0dc71d7e8cf9045065cff78226296305b25f0bc010c7830bb82019ed5
_E03_MODEL='-v $HOME/tp4/overrides/vllm/models/glm5next/nvidia/model.py:/usr/local/lib/python3.12/dist-packages/vllm/models/glm5next/nvidia/model.py:ro'
[[ "$EXTRA_DOCKER_ENV" == *"$_E03_MODEL"* ]] || { echo "E03 requires the September 19 model mount" >&2; return 1; }
EXTRA_DOCKER_ENV="${EXTRA_DOCKER_ENV/$_E03_MODEL/}"
EXTRA_DOCKER_ENV+=' -v $HOME/tp4/experiments/e03/overrides/vllm/model_executor/layers/fused_moe/runner/moe_runner.py:/usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/fused_moe/runner/moe_runner.py:ro'
EXTRA_DOCKER_ENV+=' -v $HOME/tp4/experiments/e03/overrides/vllm/model_executor/layers/fused_moe/runner/moe_runner_interface.py:/usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/fused_moe/runner/moe_runner_interface.py:ro'
EXTRA_DOCKER_ENV+=' -v $HOME/tp4/experiments/e03/overrides/vllm/model_executor/layers/linear.py:/usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/linear.py:ro'
EXTRA_DOCKER_ENV+=' -v $HOME/tp4/experiments/e03/overrides/vllm/model_executor/layers/mamba/gdn/kimi_gdn_linear_attn.py:/usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/mamba/gdn/kimi_gdn_linear_attn.py:ro'
EXTRA_DOCKER_ENV+=' -v $HOME/tp4/experiments/e03/overrides/vllm/model_executor/layers/mla.py:/usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/mla.py:ro'
EXTRA_DOCKER_ENV+=' -v $HOME/tp4/experiments/e03/overrides/vllm/models/glm5next/nvidia/attention.py:/usr/local/lib/python3.12/dist-packages/vllm/models/glm5next/nvidia/attention.py:ro'
EXTRA_DOCKER_ENV+=' -v $HOME/tp4/experiments/e03/overrides/vllm/models/glm5next/nvidia/kda.py:/usr/local/lib/python3.12/dist-packages/vllm/models/glm5next/nvidia/kda.py:ro'
EXTRA_DOCKER_ENV+=' -v $HOME/tp4/experiments/e03/overrides/vllm/models/glm5next/nvidia/mhc_prefill_sharding.py:/usr/local/lib/python3.12/dist-packages/vllm/models/glm5next/nvidia/mhc_prefill_sharding.py:ro'
EXTRA_DOCKER_ENV+=' -v $HOME/tp4/experiments/e03/overrides/vllm/models/glm5next/nvidia/model.py:/usr/local/lib/python3.12/dist-packages/vllm/models/glm5next/nvidia/model.py:ro'
unset _E03_MODEL
