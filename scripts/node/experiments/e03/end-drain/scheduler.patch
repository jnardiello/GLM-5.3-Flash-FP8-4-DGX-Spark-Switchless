+    def _e29_would_hold(self, request: Request) -> bool:
+        """E29: whether this running request is held for this step."""
+        return self.e29_end_drain and _e29_end_drain_holds(
+            request.num_output_tokens,
+            request.num_output_placeholders,
+            request.max_tokens,
+            request.is_prefill_chunk,
+            request.use_structured_output,
+        )
+
+    def _e29_count_hold(self, request: Request) -> None:
+        """E29: count one hold per request episode (empty steps may repeat it)."""
+        if request.request_id in self.e29_held_ids:
+            return
+        self.e29_held_ids.add(request.request_id)
+        self.e29_holds += 1
+        if self.e29_trace:
+            logger.info(
+                "E29_TRACE hold req=%s out=%d placeholders=%d max=%d step=%d t=%.6f",
+                request.request_id,
+                request.num_output_tokens,
+                request.num_output_placeholders,
+                request.max_tokens,
+                self.current_step,
+                time.monotonic(),
+            )
+        if self.e29_holds == 1 or self.e29_holds % 1000 == 0:
+            logger.info(
+                "E29_END_DRAIN_HELD count=%d resumed=%d",
+                self.e29_holds,
+                self.e29_resumes,
+            )
+
+    def _e29_count_resume(self, request: Request) -> None:
+        """E29: the held step did not finish the request; it is scheduled again."""
+        self.e29_held_ids.discard(request.request_id)
+        self.e29_resumes += 1
+        if self.e29_trace:
+            logger.info(
+                "E29_TRACE resume req=%s out=%d max=%d step=%d t=%.6f",
+                request.request_id,
+                request.num_output_tokens,
+                request.max_tokens,
+                self.current_step,
+                time.monotonic(),
+            )
+
