+# E29 (TP4 candidate): under async scheduling the vendor length guard skips another
+# step only when the step in flight is certain to reach max_tokens (O + 1 >= M). With
+# seven drafts a length-capped request usually finishes inside a step that could
+# produce several tokens, so one more speculative step is already queued and runs for
+# nothing while the next request waits. With VLLM_E29_END_DRAIN=1 a running request is
+# not given another step while its step in flight may finish it (O + P >= M); it
+# resumes normally if that output falls short. EOS and stop strings are unchanged.
+# Unset or 0 keeps the vendor behaviour exactly.
+def _e29_flag(name: str) -> bool:
+    import os
+
+    value = os.environ.get(name, "0")
+    if value not in ("0", "1"):
+        raise ValueError(f"{name} must be 0 or 1")
+    return value == "1"
+
+
+def _e29_end_drain_holds(
+    output_tokens: int,
+    placeholders: int,
+    max_tokens: int | None,
+    is_prefill_chunk: bool,
+    structured_output: bool,
+) -> bool:
+    """Whether the step in flight may already finish this request by length, so
+    another speculative step dispatched now could be wasted work. Structured
+    output is excluded: its grammar mask for retained drafts is only validated
+    while a step is in flight, so it keeps the vendor pipeline."""
+    return (
+        not is_prefill_chunk
+        and not structured_output
+        and placeholders > 0
+        and max_tokens is not None
+        and output_tokens + placeholders >= max_tokens
+    )
+
+
