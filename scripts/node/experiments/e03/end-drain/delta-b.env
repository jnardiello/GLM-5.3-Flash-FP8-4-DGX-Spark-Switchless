# E29 end-drain candidate, load B: the load A overlay (delta.env) with the idle-coalescing
# window set from load A's trace and the trace off, for the Rigmark suites. In load A the
# arrivals of 21 two- and four-request cohorts spread over 1.45 ms at the median and 3.17 ms
# at most, and the engine dispatched the first request alone after about 0.7 ms; 4 ms covers
# every cohort. Self-contained so that it deploys as one file.
# Enter: down with the overlay that started the running stack, then deploy/up with this one.
# Return: down with this overlay, then deploy/up with no TP4_ENV. Use the same TP4_ENV for
# every command in the window; never change CONTAINER.
_E29_DEST=/usr/local/lib/python3.12/dist-packages/vllm/v1/core/sched/scheduler.py
_E29_SCHED_FROM="\$HOME/tp4/experiments/e03/queued-cadence/scheduler.py:$_E29_DEST:ro"
_E29_SCHED_TO="\$HOME/tp4/experiments/e03/end-drain/scheduler.py:$_E29_DEST:ro"
_E29_CORE='$HOME/tp4/experiments/e03/end-drain/core.py:/usr/local/lib/python3.12/dist-packages/vllm/v1/engine/core.py:ro'
# The argument lists are validated word by word on one line; refuse embedded newlines.
if [[ "${EXTRA_VLLM_ARGS-}" == *$'\n'* || "${EXTRA_DOCKER_ENV-}" == *$'\n'* ]]; then
  echo "E29 refuses multi-line EXTRA_VLLM_ARGS or EXTRA_DOCKER_ENV" >&2
  unset _E29_DEST _E29_SCHED_FROM _E29_SCHED_TO _E29_CORE
  return 1
fi
# Exactly one standalone KV-pool argument, and it must be the E28b 16 GiB value.
read -r -a _E29_WORDS <<<"${EXTRA_VLLM_ARGS-}"
_E29_KV=; _E29_KV_N=0
for _E29_WORD in "${_E29_WORDS[@]}"; do
  case "$_E29_WORD" in
    --kv-cache-memory*) _E29_KV=$_E29_WORD; _E29_KV_N=$((_E29_KV_N + 1)) ;;
  esac
done

if [ "${SPEC_TOKENS-}" != 7 ] || [ "${MAX_NUM_SEQS-}" != 6 ] \
   || [ "${SPEC_EXTRA_JSON-}" != '"num_speculative_tokens_per_batch_size":[[1,1,7],[2,6,3]],"kv_cache_dtype":"fp8_e4m3"' ] \
   || [ "${ASYNC_SCHEDULING-}" != 0 ] \
   || [ "$_E29_KV_N" != 1 ] || [ "$_E29_KV" != "--kv-cache-memory-bytes=17179869184" ]; then
  echo "E29 requires the default E28b recipe (seven drafts, one 16 GiB KV pool, automatic async scheduling)" >&2
  unset _E29_DEST _E29_SCHED_FROM _E29_SCHED_TO _E29_CORE _E29_KV _E29_KV_N _E29_WORDS _E29_WORD
  return 1
fi

# Every relevant docker argument must appear exactly once with the E28b value.
read -r -a _E29_WORDS <<<"${EXTRA_DOCKER_ENV-}"
_E29_PREV=
_E29_SHORT=; _E29_SHORT_N=0
_E29_QUEUED=; _E29_QUEUED_N=0
_E29_HI=; _E29_HI_N=0
_E29_DEST_N=0; _E29_FROM_N=0; _E29_BAD=0
for _E29_WORD in "${_E29_WORDS[@]}"; do
  case "$_E29_WORD" in
    --env|--env=*|-e?*) _E29_BAD=1 ;;   # only the separate "-e VAR=value" form is validated
  esac
  if [ "$_E29_PREV" = -e ]; then
    case "$_E29_WORD" in
      VLLM_E27B_SHORT_PREFILL_TOKENS=*) _E29_SHORT=${_E29_WORD#*=}; _E29_SHORT_N=$((_E29_SHORT_N + 1)) ;;
      VLLM_E27C_CADENCE_WHEN_QUEUED=*) _E29_QUEUED=${_E29_WORD#*=}; _E29_QUEUED_N=$((_E29_QUEUED_N + 1)) ;;
      VLLM_ADAPTIVE_K_HI=*) _E29_HI=${_E29_WORD#*=}; _E29_HI_N=$((_E29_HI_N + 1)) ;;
      VLLM_E29_*) _E29_BAD=1 ;;
    esac
  elif [ "$_E29_PREV" = -v ]; then
    case "$_E29_WORD" in
      *":$_E29_DEST"|*":$_E29_DEST:"*) _E29_DEST_N=$((_E29_DEST_N + 1))
        [ "$_E29_WORD" = "$_E29_SCHED_FROM" ] && _E29_FROM_N=$((_E29_FROM_N + 1)) ;;
      */vllm/v1/engine/core.py*|*/end-drain/*) _E29_BAD=1 ;;
    esac
  fi
  _E29_PREV=$_E29_WORD
done
if [ "$_E29_SHORT_N" != 1 ] || [ "$_E29_SHORT" != 2048 ] \
   || [ "$_E29_QUEUED_N" != 1 ] || [ "$_E29_QUEUED" != 1 ] \
   || [ "$_E29_HI_N" != 1 ] || [ "$_E29_HI" != 7 ] \
   || [ "$_E29_DEST_N" != 1 ] || [ "$_E29_FROM_N" != 1 ] || [ "$_E29_BAD" != 0 ]; then
  echo "E29 requires the E28b scheduler flags once with their values, exactly one E27c scheduler mount, no engine-core override and no E29 flags" >&2
  unset _E29_DEST _E29_SCHED_FROM _E29_SCHED_TO _E29_CORE _E29_KV _E29_KV_N _E29_WORDS _E29_WORD _E29_PREV \
    _E29_SHORT _E29_SHORT_N _E29_QUEUED _E29_QUEUED_N _E29_HI _E29_HI_N _E29_DEST_N _E29_FROM_N _E29_BAD
  return 1
fi

# Replace the scheduler mount word itself (the value after "-v"), never other text.
_E29_OUT=
_E29_PREV=
for _E29_WORD in "${_E29_WORDS[@]}"; do
  if [ "$_E29_PREV" = -v ] && [ "$_E29_WORD" = "$_E29_SCHED_FROM" ]; then
    _E29_OUT+="${_E29_OUT:+ }$_E29_SCHED_TO"
  else
    _E29_OUT+="${_E29_OUT:+ }$_E29_WORD"
  fi
  _E29_PREV=$_E29_WORD
done
EXTRA_DOCKER_ENV="$_E29_OUT -v $_E29_CORE -e VLLM_E29_END_DRAIN=1 -e VLLM_E29_IDLE_COALESCE_MS=4 -e VLLM_E29_TRACE=0"
unset _E29_DEST _E29_SCHED_FROM _E29_SCHED_TO _E29_CORE _E29_KV _E29_KV_N _E29_WORDS _E29_WORD _E29_PREV _E29_OUT \
  _E29_SHORT _E29_SHORT_N _E29_QUEUED _E29_QUEUED_N _E29_HI _E29_HI_N _E29_DEST_N _E29_FROM_N _E29_BAD
