 logger = init_logger(__name__)
 
 
+# E29 (TP4 candidate): when the engine goes from no work to work because requests
+# arrived, keep collecting arrivals until one fixed deadline, VLLM_E29_IDLE_COALESCE_MS
+# after the first request was taken, before the first schedule. Requests released
+# together (for example several agents after a barrier) are then prefilled in one step
+# instead of the first alone. The deadline never moves; shutdown, pause or no runnable
+# request end the wait. Only the blocking single-DP loop coalesces. 0 (default) keeps
+# the vendor loop exactly. VLLM_E29_TRACE=1 logs arrival, dispatch and retirement times.
+def _e29_idle_coalesce_seconds() -> float:
+    value = float(os.environ.get("VLLM_E29_IDLE_COALESCE_MS", "0"))
+    if not 0 <= value <= 5:
+        raise ValueError("VLLM_E29_IDLE_COALESCE_MS must be within 0-5")
+    return value / 1000
+
+
+def _e29_trace() -> bool:
+    value = os.environ.get("VLLM_E29_TRACE", "0")
+    if value not in ("0", "1"):
+        raise ValueError("VLLM_E29_TRACE must be 0 or 1")
+    return value == "1"
+
+
+def _e29_remaining(deadline: float, now: float) -> float:
+    """Seconds left before the fixed coalescing deadline (never negative)."""
+    return max(0.0, deadline - now)
+
