+    def _e29_coalesce(self, first: float) -> None:
+        deadline = first + self.e29_coalesce_s
+        taken = 0
+        while (
+            self.is_running()
+            and self.scheduler.pause_state == PauseState.UNPAUSED
+            and self.scheduler.has_unfinished_requests()
+        ):
+            remaining = _e29_remaining(deadline, time.monotonic())
+            if remaining <= 0:
+                break
+            try:
+                req = self.input_queue.get(timeout=remaining)
+            except queue.Empty:
+                break
+            self._handle_client_request(*req)
+            taken += 1
+        if self.e29_trace:
+            logger.info(
+                "E29_TRACE coalesce first=%.6f end=%.6f taken=%d",
+                first,
+                time.monotonic(),
+                taken,
+            )
