# Append to the E03 candidate.env to make one standalone TP4_ENV overlay.
# Return: coordinated down with that overlay, then deploy/up with E03 candidate.env.
[[ "${SPARK_MHC_PREFILL_SHARD:-0}" == 1 &&
   "$SPARKCACHE_CONNECTOR_SHA256" == 23c1e05cc3bbabecd6b377b493bddfdd3125341d4a6cf63534d07419fdd73b9c ]] \
  || { echo "Replay views requires the measured E03 recipe" >&2; return 1; }
_REPLAY_TARGET=/usr/local/lib/python3.12/dist-packages/sparkcache/spark_context_cache_connector.py
_REPLAY_OLD="-v ${SPARKCACHE_CONNECTOR}:${_REPLAY_TARGET}:ro"
[[ "$EXTRA_DOCKER_ENV" == *"$_REPLAY_OLD"* ]] \
  || { echo "Replay views requires the selected connector mount" >&2; return 1; }
SPARKCACHE_CONNECTOR='$HOME/tp4/sparkcache/spark_context_cache_connector-e03-replay-views.py'
SPARKCACHE_CONNECTOR_SHA256=5893f8747aa093874c46a0185f93c786265d99b5a4cd8da849a7471132422d66
_REPLAY_NEW="-v ${SPARKCACHE_CONNECTOR}:${_REPLAY_TARGET}:ro"
EXTRA_DOCKER_ENV="${EXTRA_DOCKER_ENV/$_REPLAY_OLD/$_REPLAY_NEW}"
unset _REPLAY_TARGET _REPLAY_OLD _REPLAY_NEW
