# E27b long-prefill cadence candidate: a standalone TP4_ENV applied on top of the complete
# E27 recipe (scripts/node/reference/baseline-20260924-e27.env), at six sequences like the E27
# reference. It was measured on 2026-09-24 and promoted inside E27c, so it refuses the current
# default and is the record of the measured candidate.
# Enter: down with the overlay that started the running stack, then deploy/up with this one.
# Return: down with this overlay, then deploy/up with no TP4_ENV. Use the same TP4_ENV for
# every command in the window; never change CONTAINER.
# It keeps the native --prefill-schedule-interval 8 and mounts the serving image's scheduler
# with one change: on a throttled step, a prefill with fewer than 2,048 remaining uncached
# tokens is still admitted, up to 2,048 such tokens per step. Longer prefills keep waiting
# for the cadence. Model and drafter state are unchanged, so the E22b SparkCache namespace
# is reused.
if [ "${IMAGE-}" != "ghcr.io/fujitsupolycom/sparkring-glm53-sparkcache@sha256:0d4029b3b7023cf32c37ac20279469c9a2ee16a057f25aae3bcfee9ee5fb660f" ] \
   || [ "${IMAGE_ID-}" != "sha256:5e32aaa1bbe3559e81db7706ed4286248f18d27cfdb186f6b851bf786eb43075" ] \
   || [ "${SPARKCACHE_MODE-}" != on ] \
   || [ "${SPARK_MHC_PREFILL_SHARD-}" != 1 ] \
   || [ "${MAX_MODEL_LEN-}" != 262144 ] \
   || [ "${MAX_NUM_SEQS-}" != 6 ] \
   || [ "${BATCHED_TOKENS-}" != 8192 ]; then
  echo "E27b requires the accepted E27 image, mHC prefill sharding, 262144 context, max-num-seqs 6 and an 8192-token batch" >&2
  return 1
fi

[ "${SPARKCACHE_CONFIG_SHA256-}" = f7d8989486907766c8df7ceaf67731fd2ec95e3bf474a6f63bb4303e41fbe4bc ] \
  || { echo "E27b requires the accepted E22b cache config" >&2; return 1; }

[[ "$EXTRA_DOCKER_ENV" == *" -e VLLM_E22_DRAFTER_W8A16=1"* &&
   "$EXTRA_DOCKER_ENV" == *" -e VLLM_E22_CONTEXT_KV_W8A16=0"* &&
   "$EXTRA_DOCKER_ENV" == *" -e VLLM_ADAPTIVE_K_MODE=batch-uniform"* &&
   "$EXTRA_DOCKER_ENV" != *"/vllm/v1/core/sched/scheduler.py:"* &&
   "$EXTRA_DOCKER_ENV" != *VLLM_E27B_SHORT_PREFILL_TOKENS* ]] \
  || { echo "E27b requires the accepted E22b drafter flags, the adaptive-k scheduler and no scheduler override" >&2; return 1; }

read -r -a _E27B_ARGS <<<"${EXTRA_VLLM_ARGS-}"
_E27B_SCHED=0
_E27B_CADENCE=0
_E27B_NEXT=
for _E27B_ARG in "${_E27B_ARGS[@]}"; do
  if [ "$_E27B_NEXT" = interval ]; then
    [ "$_E27B_ARG" = 8 ] && _E27B_CADENCE=$((_E27B_CADENCE + 1))
    _E27B_NEXT=
    continue
  fi
  case "$_E27B_ARG" in
    --prefill-schedule-interval) _E27B_NEXT=interval ;;
    --prefill-schedule-interval=8) _E27B_CADENCE=$((_E27B_CADENCE + 1)) ;;
    --prefill-schedule-interval=*|--long-prefill-token-threshold*)
      echo "E27b refuses another prefill cadence or a chunk threshold" >&2
      unset _E27B_ARGS _E27B_ARG _E27B_SCHED _E27B_CADENCE _E27B_NEXT
      return 1 ;;
    adaptive_k_scheduler.AdaptiveKScheduler) _E27B_SCHED=$((_E27B_SCHED + 1)) ;;
  esac
done
_E27B_COUNT=$(grep -o -- '--prefill-schedule-interval' <<<"${EXTRA_VLLM_ARGS-}" | wc -l | tr -d ' ')
[ "$_E27B_SCHED" -eq 1 ] && [ "$_E27B_CADENCE" -eq 1 ] && [ "$_E27B_COUNT" -eq 1 ] || {
  echo "E27b requires the adaptive-k scheduler class and --prefill-schedule-interval 8 exactly once" >&2
  unset _E27B_ARGS _E27B_ARG _E27B_SCHED _E27B_CADENCE _E27B_NEXT _E27B_COUNT
  return 1
}
unset _E27B_ARGS _E27B_ARG _E27B_SCHED _E27B_CADENCE _E27B_NEXT _E27B_COUNT

EXTRA_DOCKER_ENV+=' -v $HOME/tp4/experiments/e03/long-prefill-cadence/scheduler.py:/usr/local/lib/python3.12/dist-packages/vllm/v1/core/sched/scheduler.py:ro -e VLLM_E27B_SHORT_PREFILL_TOKENS=2048'
