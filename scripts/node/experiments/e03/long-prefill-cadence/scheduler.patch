+    def _e27b_admit(self, remaining: int) -> bool:
+        """E27b: admit a short prefill on a throttled step, within the limit."""
+        limit = self.e27b_short_prefill_tokens
+        if not _e27b_admits(remaining, self.e27b_step_short_prefill, limit):
+            return False
+        self.e27b_step_short_prefill += remaining
+        self.e27b_admitted += 1
+        if self.e27b_admitted == 1 or self.e27b_admitted % 1000 == 0:
+            logger.info(
+                "E27B_SHORT_PREFILL_ADMITTED count=%d remaining=%d deferred=%d",
+                self.e27b_admitted,
+                remaining,
+                self.e27b_deferred,
+            )
+        return True
+
+    def _e27b_count_deferred(self, request: Request) -> None:
+        self.e27b_deferred += 1
