 from vllm.v1.utils import record_function_or_nullcontext
 
 logger = init_logger(__name__)
+
+
+# E27b (TP4 candidate): with the native prefill cadence, a throttled step still
+# admits a prefill whose remaining uncached work is below
+# VLLM_E27B_SHORT_PREFILL_TOKENS, up to that many prefill tokens per step in
+# total. Longer prefills keep waiting for the cadence. Unset or 0 keeps the
+# vendor behaviour exactly.
+def _e27b_short_prefill_tokens() -> int:
+    import os
+
+    tokens = int(os.environ.get("VLLM_E27B_SHORT_PREFILL_TOKENS", "0"))
+    if tokens < 0:
+        raise ValueError("VLLM_E27B_SHORT_PREFILL_TOKENS must not be negative")
+    return tokens
 
 
+def _e27b_admits(remaining: int, admitted: int, limit: int) -> bool:
+    """Whether a throttled step may still admit a prefill of ``remaining``
+    tokens after ``admitted`` short-prefill tokens in the same step."""
+    return 0 < remaining < limit and admitted + remaining <= limit
+
+
