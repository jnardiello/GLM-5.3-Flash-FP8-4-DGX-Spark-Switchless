# Diagnostic overlay for the protected default. It replaces exactly the validated
# gpu_worker.py mount with the prefill-cache-trim candidate and enables its strict opt-in.
# Model, scheduler, KV pool, SparkCache configuration and allocator environment are unchanged.
_PCT_SITE=/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu_worker.py
_PCT_FROM="\$HOME/tp4/overrides/vllm/v1/worker/gpu_worker.py:$_PCT_SITE:ro"
_PCT_TO="\$HOME/tp4/experiments/e03/prefill-cache-trim/gpu_worker.py:$_PCT_SITE:ro"
if [[ "${EXTRA_DOCKER_ENV-}" == *$'\n'* ]]; then
  echo "prefill-cache-trim refuses multiline Docker arguments" >&2
  unset _PCT_SITE _PCT_FROM _PCT_TO
  return 1
fi

read -r -a _PCT_WORDS <<<"${EXTRA_DOCKER_ENV-}"
_PCT_PREV= _PCT_OUT= _PCT_FOUND=0 _PCT_TARGETS=0 _PCT_BAD=0
for _PCT_WORD in "${_PCT_WORDS[@]}"; do
  if [ "$_PCT_PREV" = -e ]; then
    case "$_PCT_WORD" in
      VLLM_PREFILL_CACHE_TRIM*) _PCT_BAD=1 ;;
    esac
  elif [ "$_PCT_PREV" = -v ]; then
    case "$_PCT_WORD" in
      *":$_PCT_SITE"|*":$_PCT_SITE:"*) _PCT_TARGETS=$((_PCT_TARGETS + 1)) ;;
      */prefill-cache-trim/*) _PCT_BAD=1 ;;
    esac
    if [ "$_PCT_WORD" = "$_PCT_FROM" ]; then
      _PCT_WORD=$_PCT_TO
      _PCT_FOUND=$((_PCT_FOUND + 1))
    fi
  fi
  _PCT_OUT+="${_PCT_OUT:+ }$_PCT_WORD"
  _PCT_PREV=$_PCT_WORD
done
if [ "$_PCT_FOUND" != 1 ] || [ "$_PCT_TARGETS" != 1 ] || [ "$_PCT_BAD" != 0 ]; then
  echo "prefill-cache-trim requires exactly one validated gpu_worker mount and no prior trim selection" >&2
  unset _PCT_SITE _PCT_FROM _PCT_TO _PCT_WORDS _PCT_WORD _PCT_PREV _PCT_OUT \
    _PCT_FOUND _PCT_TARGETS _PCT_BAD
  return 1
fi
EXTRA_DOCKER_ENV="$_PCT_OUT -e VLLM_PREFILL_CACHE_TRIM=1"
unset _PCT_SITE _PCT_FROM _PCT_TO _PCT_WORDS _PCT_WORD _PCT_PREV _PCT_OUT \
  _PCT_FOUND _PCT_TARGETS _PCT_BAD
