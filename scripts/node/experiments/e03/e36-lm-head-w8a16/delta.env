# E36 candidate over the E35 default: the vocab-parallel lm_head that the target shares with
# the DFlash2 drafter becomes INT8 W8A16 at load (e36_lm_head_w8a16.py), converted by the E36
# copy of the E35 runner. The SparkCache namespace is unchanged: logits never feed cached
# K/V, recurrent state or drafter context. Use the same TP4_ENV for every command of the
# window, `down` included.
_E36_DIR='$HOME/tp4/experiments/e03/e36-lm-head-w8a16'
_E36_VLLM=/usr/local/lib/python3.12/dist-packages/vllm
_E36_RUNNER_OLD="\$HOME/tp4/experiments/e03/e35-runner-k/model_runner.py:$_E36_VLLM/v1/worker/gpu/model_runner.py:ro"
_E36_RUNNER_NEW="$_E36_DIR/model_runner.py:$_E36_VLLM/v1/worker/gpu/model_runner.py:ro"
_E36_MODULE="$_E36_DIR/e36_lm_head_w8a16.py:$_E36_VLLM/models/glm5next/nvidia/e36_lm_head_w8a16.py:ro"
_E36_CLEAN() {
  unset _E36_DIR _E36_VLLM _E36_RUNNER_OLD _E36_RUNNER_NEW _E36_MODULE _E36_WORDS _E36_OUT \
    _E36_FOUND _E36_TARGETS _E36_OTHER _E36_PREV _E36_WORD
  unset -f _E36_CLEAN
}
if [[ "${EXTRA_DOCKER_ENV-}" == *$'\n'* ]]; then
  echo "[e36] refusing multiline Docker arguments" >&2; _E36_CLEAN; return 1
fi
# The packing reuses the mounted E21 module (and its E20 scratch helper).
case " ${EXTRA_DOCKER_ENV-} " in
  *":$_E36_VLLM/models/glm5next/nvidia/e21_bf16_residue.py:ro "*) ;;
  *) echo "[e36] requires the E21 residue module mount" >&2; _E36_CLEAN; return 1 ;;
esac
case "${EXTRA_DOCKER_ENV-}" in
  *e36-lm-head-w8a16*|*VLLM_E36_*|*e36_lm_head_w8a16*)
    echo "[e36] refusing a base that already carries an E36 selection" >&2; _E36_CLEAN; return 1 ;;
esac
read -r -a _E36_WORDS <<<"${EXTRA_DOCKER_ENV-}"
_E36_OUT= _E36_FOUND=0 _E36_TARGETS=0 _E36_OTHER=0 _E36_PREV=
for _E36_WORD in "${_E36_WORDS[@]}"; do
  case "$_E36_WORD" in
    --volume|--volume=*|--mount|--mount=*|--env-file|--env-file=*) _E36_OTHER=$((_E36_OTHER + 1)) ;;
  esac
  if [ "$_E36_PREV" = -v ]; then
    case "$_E36_WORD" in *":$_E36_VLLM/v1/worker/gpu/model_runner.py:"*|*":$_E36_VLLM/v1/worker/gpu/model_runner.py")
      _E36_TARGETS=$((_E36_TARGETS + 1)) ;; esac
    if [ "$_E36_WORD" = "$_E36_RUNNER_OLD" ]; then
      _E36_WORD=$_E36_RUNNER_NEW; _E36_FOUND=$((_E36_FOUND + 1))
    fi
  fi
  _E36_OUT+="${_E36_OUT:+ }$_E36_WORD"
  _E36_PREV=$_E36_WORD
done
if [ "$_E36_FOUND" != 1 ] || [ "$_E36_TARGETS" != 1 ] || [ "$_E36_OTHER" != 0 ]; then
  echo "[e36] requires exactly one E35 runner mount and no --volume/--mount/--env-file forms" >&2
  _E36_CLEAN; return 1
fi
EXTRA_DOCKER_ENV="$_E36_OUT -v $_E36_MODULE -e VLLM_E36_LM_HEAD_W8A16=1 -e VLLM_E36_KEEP_BF16=0"
_E36_CLEAN
