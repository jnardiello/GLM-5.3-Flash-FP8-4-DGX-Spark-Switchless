# Append after E03 candidate.env + replay-views/delta.env in one standalone TP4_ENV.
# Return: down with this combined overlay, deploy/up with the E03 + replay overlay.
# A coordinated transition requires a new authorized window; never change CONTAINER.
[[ "${SPARK_MHC_PREFILL_SHARD:-0}" == 1 &&
   "$SPARKCACHE_CONNECTOR_SHA256" == 5893f8747aa093874c46a0185f93c786265d99b5a4cd8da849a7471132422d66 ]] \
  || { echo "Draft budget requires E03 with the replay views connector" >&2; return 1; }
_BUDGET_OLD='-v $HOME/patches/adaptive_k_scheduler.py:/opt/tp4/adaptive_k_scheduler.py:ro'
_BUDGET_NEW='-v $HOME/tp4/experiments/e03/draft-budget/adaptive_k_scheduler.py:/opt/tp4/adaptive_k_scheduler.py:ro'
[[ "$EXTRA_DOCKER_ENV" == *"$_BUDGET_OLD"* &&
   "$EXTRA_DOCKER_ENV" != *VLLM_ADAPTIVE_K_RESPECT_DRAFT_BUDGET* ]] \
  || { echo "Draft budget requires the original scheduler mount and an unset cap flag" >&2; return 1; }
_BUDGET_REST="${EXTRA_DOCKER_ENV/$_BUDGET_OLD/}"
[[ "$_BUDGET_REST" != *:/opt/tp4/adaptive_k_scheduler.py:* ]] \
  || { echo "Draft budget requires exactly one scheduler mount" >&2; return 1; }
EXTRA_DOCKER_ENV="${EXTRA_DOCKER_ENV/$_BUDGET_OLD/$_BUDGET_NEW}"
EXTRA_DOCKER_ENV+=' -e VLLM_ADAPTIVE_K_RESPECT_DRAFT_BUDGET=1'
unset _BUDGET_OLD _BUDGET_NEW _BUDGET_REST
