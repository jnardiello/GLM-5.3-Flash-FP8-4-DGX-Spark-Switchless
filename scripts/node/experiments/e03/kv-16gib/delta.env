# E28b KV-pool candidate: a standalone TP4_ENV applied on top of the default E28 recipe in
# cluster.env, with no other overlay. It raises the KV pool from 15 GiB to 16 GiB per rank
# (--kv-cache-memory-bytes 17179869184) so that five full 262,144-token contexts fit together
# with seven draft tokens. Nothing else changes; the cache namespace is reused.
# Enter: down with the overlay that started the running stack, then deploy/up with this one.
# Return: down with this overlay, then deploy/up with no TP4_ENV. Never change CONTAINER.
if [ "${SPEC_TOKENS-}" != 7 ] || [ "${MAX_NUM_SEQS-}" != 6 ] \
   || [ "${SPEC_EXTRA_JSON-}" != '"num_speculative_tokens_per_batch_size":[[1,1,7],[2,6,3]],"kv_cache_dtype":"fp8_e4m3"' ] \
   || [[ "$EXTRA_DOCKER_ENV" != *" -e VLLM_ADAPTIVE_K_HI=7"* ]]; then
  echo "E28b requires the E28 default recipe" >&2
  return 1
fi
_E28B_KV=$(grep -o -- '--kv-cache-memory[^ ]*' <<<"${EXTRA_VLLM_ARGS-}")
[ "$_E28B_KV" = "--kv-cache-memory-bytes=16106127360" ] || {
  echo "E28b requires exactly one 16106127360-byte KV pool argument" >&2
  unset _E28B_KV
  return 1
}
unset _E28B_KV
EXTRA_VLLM_ARGS="${EXTRA_VLLM_ARGS/--kv-cache-memory-bytes=16106127360/--kv-cache-memory-bytes=17179869184}"
