# E35 candidate over the E31-MB default: confidence-based verify length decided in the V2
# model runner. Mounts the runner and DFlash2 speculator with their additions and the
# adaptive-k scheduler copy, enables the mechanism and names the policy flag file
# (/tmp/glm53-e35-policy in the rank-0 container; missing or "ema" keeps the default
# behaviour). Use the same TP4_ENV for every command of the window, `down` included.
_E35_DIR='$HOME/tp4/experiments/e03/e35-runner-k'
_E35_SCHED_OLD='$HOME/tp4/experiments/e03/draft-budget/adaptive_k_scheduler.py:/opt/tp4/adaptive_k_scheduler.py:ro'
_E35_SCHED_NEW="$_E35_DIR/adaptive_k_scheduler.py:/opt/tp4/adaptive_k_scheduler.py:ro"
_E35_VLLM=/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu
if [[ "${EXTRA_DOCKER_ENV-}" == *$'\n'* ]]; then
  echo "[e35] refusing multiline Docker arguments" >&2; return 1
fi
# The runner participates only in steps with seven drafts: require the recipe that makes them.
if [ "${SPEC_TOKENS-}" != 7 ] || [[ " ${EXTRA_DOCKER_ENV-} " != *" -e VLLM_ADAPTIVE_K_HI=7 "* ]]; then
  echo "[e35] requires SPEC_TOKENS=7 and VLLM_ADAPTIVE_K_HI=7" >&2; return 1
fi
case "${EXTRA_DOCKER_ENV-}" in
  *e35-runner-k*|*e34-confidence-k*|*e33-diag*|*"$_E35_VLLM/model_runner.py"*|\
  *"$_E35_VLLM/spec_decode/dflash2/speculator.py"*|*VLLM_E35_*|*VLLM_E34_*|*VLLM_E33_*)
    echo "[e35] refusing a base that already carries an E33/E34/E35 selection" >&2; return 1 ;;
esac
read -r -a _E35_WORDS <<<"${EXTRA_DOCKER_ENV-}"
_E35_OUT= _E35_FOUND=0 _E35_TARGETS=0 _E35_OTHER=0 _E35_PREV=
for _E35_WORD in "${_E35_WORDS[@]}"; do
  case "$_E35_WORD" in
    --volume|--volume=*|--mount|--mount=*|--env-file|--env-file=*) _E35_OTHER=$((_E35_OTHER + 1)) ;;
  esac
  if [ "$_E35_PREV" = -v ]; then
    case "$_E35_WORD" in *:/opt/tp4/adaptive_k_scheduler.py|*:/opt/tp4/adaptive_k_scheduler.py:*)
      _E35_TARGETS=$((_E35_TARGETS + 1)) ;; esac
    if [ "$_E35_WORD" = "$_E35_SCHED_OLD" ]; then
      _E35_WORD=$_E35_SCHED_NEW; _E35_FOUND=$((_E35_FOUND + 1))
    fi
  fi
  _E35_OUT+="${_E35_OUT:+ }$_E35_WORD"
  _E35_PREV=$_E35_WORD
done
if [ "$_E35_FOUND" != 1 ] || [ "$_E35_TARGETS" != 1 ] || [ "$_E35_OTHER" != 0 ]; then
  echo "[e35] requires exactly one default adaptive-k scheduler mount and no --volume/--mount/--env-file forms" >&2
  unset _E35_DIR _E35_SCHED_OLD _E35_SCHED_NEW _E35_VLLM _E35_WORDS _E35_OUT _E35_FOUND \
    _E35_TARGETS _E35_OTHER _E35_PREV _E35_WORD
  return 1
fi
EXTRA_DOCKER_ENV="$_E35_OUT -v $_E35_DIR/model_runner.py:$_E35_VLLM/model_runner.py:ro -v $_E35_DIR/speculator.py:$_E35_VLLM/spec_decode/dflash2/speculator.py:ro -e VLLM_E35_ENABLE=1 -e VLLM_E35_POLICY_FLAG=/tmp/glm53-e35-policy"
unset _E35_DIR _E35_SCHED_OLD _E35_SCHED_NEW _E35_VLLM _E35_WORDS _E35_OUT _E35_FOUND \
  _E35_TARGETS _E35_OTHER _E35_PREV _E35_WORD
