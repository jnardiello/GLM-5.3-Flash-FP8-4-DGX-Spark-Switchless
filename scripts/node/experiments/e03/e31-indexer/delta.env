# E31 indexer candidate: a standalone TP4_ENV applied on top of the default E29 recipe in
# cluster.env, with no other overlay. It swaps only the production pooled_indexer.py and
# ops/glm_kpool.py mounts for the E31 copies and names the in-container flag files that
# select, at runtime, the head-gate path and the C4 tail ring. With the switches unset the
# load starts on the FP32 head gate and the speculative-safe tail ring (E31 defaults).
# Model, drafter, KV pool, scheduler and cache namespace are unchanged.
# Enter: down with the overlay that started the running stack, then deploy/up with this one.
# Return: down with this overlay, then deploy/up with no TP4_ENV. Use the same TP4_ENV for
# every command in the window; never change CONTAINER.
_E31_SITE=/usr/local/lib/python3.12/dist-packages/vllm
_E31_DEST=$_E31_SITE/models/glm5next/nvidia/pooled_indexer.py
_E31_FROM="\$HOME/tp4/overrides/vllm/models/glm5next/nvidia/pooled_indexer.py:$_E31_DEST:ro"
_E31_TO="\$HOME/tp4/experiments/e03/e31-indexer/pooled_indexer.py:$_E31_DEST:ro"
_E31_E29="\$HOME/tp4/experiments/e03/end-drain/scheduler.py:$_E31_SITE/v1/core/sched/scheduler.py:ro"
_E31_KDEST=$_E31_SITE/models/glm5next/nvidia/ops/glm_kpool.py
_E31_KFROM="\$HOME/tp4/overrides/vllm/models/glm5next/nvidia/ops/glm_kpool.py:$_E31_KDEST:ro"
_E31_KTO="\$HOME/tp4/experiments/e03/e31-indexer/glm_kpool.py:$_E31_KDEST:ro"
# The argument list is validated word by word on one line; refuse embedded newlines.
if [[ "${EXTRA_DOCKER_ENV-}" == *$'\n'* ]]; then
  echo "E31 refuses a multi-line EXTRA_DOCKER_ENV" >&2
  unset _E31_SITE _E31_DEST _E31_FROM _E31_TO _E31_E29 _E31_KDEST _E31_KFROM _E31_KTO
  return 1
fi

# The E29 scheduler, the production indexer and the production kpool kernels must each be
# mounted exactly once, with no other mount of either file, no E31 variable and only the
# separate "-e VAR=value" form.
read -r -a _E31_WORDS <<<"${EXTRA_DOCKER_ENV-}"
_E31_PREV=
_E31_FROM_N=0; _E31_DEST_N=0; _E31_E29_N=0; _E31_KFROM_N=0; _E31_KDEST_N=0; _E31_BAD=0
for _E31_WORD in "${_E31_WORDS[@]}"; do
  case "$_E31_WORD" in
    --env|--env=*|-e?*) _E31_BAD=1 ;;
  esac
  if [ "$_E31_PREV" = -e ]; then
    case "$_E31_WORD" in
      VLLM_GLM53_INDEXER_GATE_TC*|VLLM_GLM53_KPOOL_TAIL_RING*) _E31_BAD=1 ;;
    esac
  elif [ "$_E31_PREV" = -v ]; then
    case "$_E31_WORD" in
      *":$_E31_DEST"|*":$_E31_DEST:"*) _E31_DEST_N=$((_E31_DEST_N + 1))
        [ "$_E31_WORD" = "$_E31_FROM" ] && _E31_FROM_N=$((_E31_FROM_N + 1)) ;;
      *":$_E31_KDEST"|*":$_E31_KDEST:"*) _E31_KDEST_N=$((_E31_KDEST_N + 1))
        [ "$_E31_WORD" = "$_E31_KFROM" ] && _E31_KFROM_N=$((_E31_KFROM_N + 1)) ;;
      "$_E31_E29") _E31_E29_N=$((_E31_E29_N + 1)) ;;
      */e31-indexer/*) _E31_BAD=1 ;;
    esac
  fi
  _E31_PREV=$_E31_WORD
done
if [ "$_E31_DEST_N" != 1 ] || [ "$_E31_FROM_N" != 1 ] || [ "$_E31_E29_N" != 1 ] \
   || [ "$_E31_KDEST_N" != 1 ] || [ "$_E31_KFROM_N" != 1 ] || [ "$_E31_BAD" != 0 ]; then
  echo "E31 requires the E29 default: one production pooled_indexer and glm_kpool mount each, the E29 scheduler, no E31 mount or variable" >&2
  unset _E31_SITE _E31_DEST _E31_FROM _E31_TO _E31_E29 _E31_KDEST _E31_KFROM _E31_KTO _E31_WORDS _E31_WORD _E31_PREV \
    _E31_FROM_N _E31_DEST_N _E31_E29_N _E31_KFROM_N _E31_KDEST_N _E31_BAD
  return 1
fi

# Replace the two mount words themselves (the values after "-v"), never other text.
_E31_OUT=
_E31_PREV=
for _E31_WORD in "${_E31_WORDS[@]}"; do
  if [ "$_E31_PREV" = -v ] && [ "$_E31_WORD" = "$_E31_FROM" ]; then
    _E31_OUT+="${_E31_OUT:+ }$_E31_TO"
  elif [ "$_E31_PREV" = -v ] && [ "$_E31_WORD" = "$_E31_KFROM" ]; then
    _E31_OUT+="${_E31_OUT:+ }$_E31_KTO"
  else
    _E31_OUT+="${_E31_OUT:+ }$_E31_WORD"
  fi
  _E31_PREV=$_E31_WORD
done
EXTRA_DOCKER_ENV="$_E31_OUT -e VLLM_GLM53_INDEXER_GATE_TC_FLAG=/tmp/glm53-indexer-gate-tc"
EXTRA_DOCKER_ENV+=" -e VLLM_GLM53_KPOOL_TAIL_RING_FLAG=/tmp/glm53-kpool-tail-ring"
unset _E31_SITE _E31_DEST _E31_FROM _E31_TO _E31_E29 _E31_KDEST _E31_KFROM _E31_KTO _E31_WORDS _E31_WORD _E31_PREV _E31_OUT \
  _E31_FROM_N _E31_DEST_N _E31_E29_N _E31_KFROM_N _E31_KDEST_N _E31_BAD
