+# E31 (TP4 candidate) switches. Each NAME (0/1, read at import) sets a default; a file
+# named by NAME_FLAG overrides it with content 1/0, re-read at most every 0.5 s; a
+# missing or unreadable file, or other content, means the default.
+# VLLM_GLM53_INDEXER_GATE_TC (default 0), after the Apache-2.0 RiNGSiDE patch of that
+# name: the head gate as a BF16 tensor-core GEMM with FP32 output. Both operands are
+# exact BF16 values, so the products equal the FP32 path's; only accumulation order
+# differs. VLLM_GLM53_KPOOL_TAIL_RING (default 1): the speculative-safe tail ring of
+# ops/glm_kpool.py; 0 keeps the legacy four slots. Switch the ring only while no request
+# is running, because the tail contents are specific to the ring size.
+logger = init_logger(__name__)
 
+
+def _e31_switch(name: str, default: str) -> dict:
+    value = os.environ.get(name, default)
+    if value not in ("0", "1"):
+        raise ValueError(f"{name} must be 0 or 1")
+    flag = os.environ.get(f"{name}_FLAG") or None
+    return {"default": value, "on": value == "1", "flag": flag, "at": -1.0}
+
+
+def _e31_on(switch: dict) -> bool:
+    if switch["flag"] is not None and time.monotonic() - switch["at"] >= 0.5:
+        switch["at"] = time.monotonic()
+        try:
+            with open(switch["flag"]) as flag:
+                value = flag.read().strip()
+        except OSError:
+            value = switch["default"]
+        switch["on"] = (value if value in ("0", "1") else switch["default"]) == "1"
+    return bool(switch["on"])
+
+
+_E31_GATE_TC = _e31_switch("VLLM_GLM53_INDEXER_GATE_TC", "0")
+_E31_TAIL_RING = _e31_switch("VLLM_GLM53_KPOOL_TAIL_RING", "1")
+_e31 = {"usable": True, "path": None, "ring": None}
+
