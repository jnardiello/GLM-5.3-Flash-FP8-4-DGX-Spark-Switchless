# Historical parity overlay for the measured E31 recipe; the protected default already
# contains these settings. Do not select this over the current default. Tests apply it to
# baseline-20260928-e31.env to prove all four launcher commands remain identical.
if [ "${SPARKCACHE_MODE-}" != on ] \
   || [ "${SPARKCACHE_CONNECTOR_SHA256-}" != 5893f8747aa093874c46a0185f93c786265d99b5a4cd8da849a7471132422d66 ] \
   || [ "${SPARKCACHE_CONFIG_SHA256-}" != f7d8989486907766c8df7ceaf67731fd2ec95e3bf474a6f63bb4303e41fbe4bc ] \
   || [ "${SPARKCACHE_ENCODER_SHA256-}" != 11a2db855306b816a4f3d377d04207cc2d62112a381bcc54162099248bbf75f6 ]; then
  echo "SparkCache CPU budget requires the current E03 connector and E22b cache identity" >&2
  return 1
fi
_SCB_TARGET=/usr/local/lib/python3.12/dist-packages/sparkcache/spark_context_cache_connector.py
_SCB_FROM="${SPARKCACHE_CONNECTOR}:$_SCB_TARGET:ro"
_SCB_TO="\$HOME/tp4/sparkcache/spark_context_cache_connector-ram-budget.py:$_SCB_TARGET:ro"
if [[ "${EXTRA_DOCKER_ENV-}" == *$'\n'* ]]; then
  echo "SparkCache CPU budget refuses multiline Docker arguments" >&2
  unset _SCB_TARGET _SCB_FROM _SCB_TO
  return 1
fi
read -r -a _SCB_WORDS <<<"${EXTRA_DOCKER_ENV-}"
_SCB_PREV= _SCB_OUT= _SCB_FOUND=0 _SCB_TARGETS=0
for _SCB_WORD in "${_SCB_WORDS[@]}"; do
  if [ "$_SCB_PREV" = -v ]; then
    case "$_SCB_WORD" in
      *":$_SCB_TARGET"|*":$_SCB_TARGET:"*) _SCB_TARGETS=$((_SCB_TARGETS + 1)) ;;
    esac
    if [ "$_SCB_WORD" = "$_SCB_FROM" ]; then
      _SCB_WORD=$_SCB_TO
      _SCB_FOUND=$((_SCB_FOUND + 1))
    fi
  fi
  _SCB_OUT+="${_SCB_OUT:+ }$_SCB_WORD"
  _SCB_PREV=$_SCB_WORD
done
if [ "$_SCB_FOUND" != 1 ] || [ "$_SCB_TARGETS" != 1 ]; then
  echo "SparkCache CPU budget requires exactly one current connector mount" >&2
  unset _SCB_TARGET _SCB_FROM _SCB_TO _SCB_WORDS _SCB_WORD _SCB_PREV _SCB_OUT _SCB_FOUND _SCB_TARGETS
  return 1
fi
EXTRA_DOCKER_ENV=$_SCB_OUT
unset _SCB_TARGET _SCB_FROM _SCB_TO _SCB_WORDS _SCB_WORD _SCB_PREV _SCB_OUT _SCB_FOUND _SCB_TARGETS
SPARKCACHE_CONNECTOR='$HOME/tp4/sparkcache/spark_context_cache_connector-ram-budget.py'
SPARKCACHE_CONNECTOR_SHA256=aa046965637b685ec1f6a00e427eb46279e28bf0d49ee546236bc774be2de9bd
SPARKCACHE_CONFIG='$HOME/tp4/experiments/e03/sparkcache-ram-budget/kv-transfer-config.json'
SPARKCACHE_CONFIG_SHA256=d99bd6720572b2f46668d0a11229f7662f1e8fdd69a69f61cbfa5592aa600c72
