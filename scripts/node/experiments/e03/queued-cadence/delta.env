# E27c queued-cadence candidate: a standalone TP4_ENV applied on top of the complete E27
# recipe (scripts/node/reference/baseline-20260924-e27.env), at six sequences like the E27
# reference. E27c was promoted on 2026-09-25: cluster.env.example now encodes it, so this
# overlay refuses the current default and is the record of the measured candidate.
# Enter: down with the overlay that started the running stack, then deploy/up with this one.
# Return: down with this overlay, then deploy/up with no TP4_ENV. Use the same TP4_ENV for
# every command in the window; never change CONTAINER.
# It contains E27b (short prefills below 2,048 remaining tokens are admitted on a deferred
# step, up to 2,048 per step) and additionally keeps the native --prefill-schedule-interval 8
# while requests wait in the queue, instead of letting the vendor capacity latch switch the
# cadence off. Several long contexts arriving together are then prefilled one chunk per
# cadence step while the streams already decoding keep generating. Model and drafter state
# are unchanged, so the E22b SparkCache namespace is reused.
if [ "${IMAGE-}" != "ghcr.io/fujitsupolycom/sparkring-glm53-sparkcache@sha256:0d4029b3b7023cf32c37ac20279469c9a2ee16a057f25aae3bcfee9ee5fb660f" ] \
   || [ "${IMAGE_ID-}" != "sha256:5e32aaa1bbe3559e81db7706ed4286248f18d27cfdb186f6b851bf786eb43075" ] \
   || [ "${SPARKCACHE_MODE-}" != on ] \
   || [ "${SPARK_MHC_PREFILL_SHARD-}" != 1 ] \
   || [ "${MAX_MODEL_LEN-}" != 262144 ] \
   || [ "${MAX_NUM_SEQS-}" != 6 ] \
   || [ "${BATCHED_TOKENS-}" != 8192 ]; then
  echo "E27c requires the accepted E27 image, mHC prefill sharding, 262144 context, max-num-seqs 6 and an 8192-token batch" >&2
  return 1
fi

[ "${SPARKCACHE_CONFIG_SHA256-}" = f7d8989486907766c8df7ceaf67731fd2ec95e3bf474a6f63bb4303e41fbe4bc ] \
  || { echo "E27c requires the accepted E22b cache config" >&2; return 1; }

[[ "$EXTRA_DOCKER_ENV" == *" -e VLLM_E22_DRAFTER_W8A16=1"* &&
   "$EXTRA_DOCKER_ENV" == *" -e VLLM_E22_CONTEXT_KV_W8A16=0"* &&
   "$EXTRA_DOCKER_ENV" == *" -e VLLM_ADAPTIVE_K_MODE=batch-uniform"* &&
   "$EXTRA_DOCKER_ENV" != *"/vllm/v1/core/sched/scheduler.py:"* &&
   "$EXTRA_DOCKER_ENV" != *VLLM_E27B_SHORT_PREFILL_TOKENS* &&
   "$EXTRA_DOCKER_ENV" != *VLLM_E27C_CADENCE_WHEN_QUEUED* ]] \
  || { echo "E27c requires the accepted E22b drafter flags, the adaptive-k scheduler and no scheduler override" >&2; return 1; }

read -r -a _E27C_ARGS <<<"${EXTRA_VLLM_ARGS-}"
_E27C_SCHED=0
_E27C_CADENCE=0
_E27C_NEXT=
for _E27C_ARG in "${_E27C_ARGS[@]}"; do
  if [ "$_E27C_NEXT" = interval ]; then
    [ "$_E27C_ARG" = 8 ] && _E27C_CADENCE=$((_E27C_CADENCE + 1))
    _E27C_NEXT=
    continue
  fi
  case "$_E27C_ARG" in
    --prefill-schedule-interval) _E27C_NEXT=interval ;;
    --prefill-schedule-interval=8) _E27C_CADENCE=$((_E27C_CADENCE + 1)) ;;
    --prefill-schedule-interval=*|--long-prefill-token-threshold*)
      echo "E27c refuses another prefill cadence or a chunk threshold" >&2
      unset _E27C_ARGS _E27C_ARG _E27C_SCHED _E27C_CADENCE _E27C_NEXT
      return 1 ;;
    adaptive_k_scheduler.AdaptiveKScheduler) _E27C_SCHED=$((_E27C_SCHED + 1)) ;;
  esac
done
_E27C_COUNT=$(grep -o -- '--prefill-schedule-interval' <<<"${EXTRA_VLLM_ARGS-}" | wc -l | tr -d ' ')
[ "$_E27C_SCHED" -eq 1 ] && [ "$_E27C_CADENCE" -eq 1 ] && [ "$_E27C_COUNT" -eq 1 ] || {
  echo "E27c requires the adaptive-k scheduler class and --prefill-schedule-interval 8 exactly once" >&2
  unset _E27C_ARGS _E27C_ARG _E27C_SCHED _E27C_CADENCE _E27C_NEXT _E27C_COUNT
  return 1
}
unset _E27C_ARGS _E27C_ARG _E27C_SCHED _E27C_CADENCE _E27C_NEXT _E27C_COUNT

EXTRA_DOCKER_ENV+=' -v $HOME/tp4/experiments/e03/queued-cadence/scheduler.py:/usr/local/lib/python3.12/dist-packages/vllm/v1/core/sched/scheduler.py:ro -e VLLM_E27B_SHORT_PREFILL_TOKENS=2048 -e VLLM_E27C_CADENCE_WHEN_QUEUED=1'
