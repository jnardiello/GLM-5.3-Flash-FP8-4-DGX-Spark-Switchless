# Conditional production candidate layered over the protected E31 operational default.
# This file is inert unless explicitly selected with TP4_ENV. It keeps the production
# SparkCache namespace and replaces only the worker, scheduler, KV budget and API admission.
if [ "${SPARKCACHE_MODE-}" != on ] \
   || [ "${SPARKCACHE_CONNECTOR_SHA256-}" != aa046965637b685ec1f6a00e427eb46279e28bf0d49ee546236bc774be2de9bd ] \
   || [ "${SPARKCACHE_CONFIG_SHA256-}" != d99bd6720572b2f46668d0a11229f7662f1e8fdd69a69f61cbfa5592aa600c72 ] \
   || [ "${SPARKCACHE_ENCODER_SHA256-}" != 11a2db855306b816a4f3d377d04207cc2d62112a381bcc54162099248bbf75f6 ]; then
  echo "memory-bounded candidate requires the protected production SparkCache identity" >&2
  return 1
fi
if [ "${MAX_MODEL_LEN-}" != 262144 ] || [ "${MAX_NUM_SEQS-}" != 6 ] \
   || [ "${BATCHED_TOKENS-}" != 8192 ] || [ "${BLOCK_SIZE-}" != 2304 ]; then
  echo "memory-bounded candidate requires the E31 context, concurrency and scheduler budgets" >&2
  return 1
fi
if [[ "${EXTRA_DOCKER_ENV-}" == *$'\n'* ]] || [[ "${EXTRA_VLLM_ARGS-}" == *$'\n'* ]]; then
  echo "memory-bounded candidate refuses multiline Docker or vLLM arguments" >&2
  return 1
fi
case "${EXTRA_DOCKER_ENV-}" in
  *VLLM_PREFILL_CACHE_TRIM*|*VLLM_RESILIENCE_STEP_TOKEN_CAP*|*TP4_ADMISSION_*|\
  *TP4_RESILIENCE_*|*SPARK_CONTEXT_CACHE_MAX_BYTES*|*SPARK_CONTEXT_CACHE_LOW_WATERMARK_BYTES*)
    echo "memory-bounded candidate refuses a prior diagnostic or admission selection" >&2
    return 1 ;;
  */scripts/resilience/.campaign/*|*/opt/tp4-resilience/*)
    echo "memory-bounded candidate refuses resilience campaign mounts" >&2
    return 1 ;;
esac

_MBA_REPLACE_MOUNT() {
  local _mba_from=$1 _mba_to=$2 _mba_site=$3 _mba_word _mba_prev="" _mba_out=""
  local _mba_found=0 _mba_targets=0
  local -a _mba_words
  read -r -a _mba_words <<<"${EXTRA_DOCKER_ENV-}"
  for _mba_word in "${_mba_words[@]}"; do
    if [ "$_mba_prev" = -v ]; then
      case "$_mba_word" in
        *":$_mba_site"|*":$_mba_site:"*) _mba_targets=$((_mba_targets + 1)) ;;
      esac
      if [ "$_mba_word" = "$_mba_from" ]; then
        _mba_word=$_mba_to
        _mba_found=$((_mba_found + 1))
      fi
    fi
    _mba_out+="${_mba_out:+ }$_mba_word"
    _mba_prev=$_mba_word
  done
  if [ "$_mba_found" != 1 ] || [ "$_mba_targets" != 1 ]; then
    echo "memory-bounded candidate requires exactly one validated mount at $_mba_site" >&2
    return 1
  fi
  EXTRA_DOCKER_ENV=$_mba_out
}

_MBA_WORKER_SITE=/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu_worker.py
_MBA_REPLACE_MOUNT \
  "\$HOME/tp4/overrides/vllm/v1/worker/gpu_worker.py:$_MBA_WORKER_SITE:ro" \
  "\$HOME/tp4/experiments/e03/prefill-cache-trim/gpu_worker.py:$_MBA_WORKER_SITE:ro" \
  "$_MBA_WORKER_SITE" || return 1
_MBA_SCHEDULER_SITE=/usr/local/lib/python3.12/dist-packages/vllm/v1/core/sched/scheduler.py
_MBA_REPLACE_MOUNT \
  "\$HOME/tp4/experiments/e03/end-drain/scheduler.py:$_MBA_SCHEDULER_SITE:ro" \
  "\$HOME/tp4/experiments/e03/prefill-step-cap/scheduler.py:$_MBA_SCHEDULER_SITE:ro" \
  "$_MBA_SCHEDULER_SITE" || return 1
unset -f _MBA_REPLACE_MOUNT

_MBA_ADMISSION_SITE=/opt/tp4/tp4_admission.py
_MBA_ADMISSION_TARGETS=0
_MBA_PREV=""
read -r -a _MBA_DOCKER_WORDS <<<"${EXTRA_DOCKER_ENV-}"
for _MBA_WORD in "${_MBA_DOCKER_WORDS[@]}"; do
  if [ "$_MBA_PREV" = -v ]; then
    case "$_MBA_WORD" in
      *":$_MBA_ADMISSION_SITE"|*":$_MBA_ADMISSION_SITE:"*)
        _MBA_ADMISSION_TARGETS=$((_MBA_ADMISSION_TARGETS + 1)) ;;
    esac
  fi
  _MBA_PREV=$_MBA_WORD
done
if [ "$_MBA_ADMISSION_TARGETS" != 0 ]; then
  echo "memory-bounded candidate refuses an existing admission middleware mount" >&2
  return 1
fi

_MBA_KV_FOUND=0
_MBA_KV_BAD=0
_MBA_VLLM_OUT=""
read -r -a _MBA_VLLM_WORDS <<<"${EXTRA_VLLM_ARGS-}"
_MBA_I=0
while [ "$_MBA_I" -lt "${#_MBA_VLLM_WORDS[@]}" ]; do
  _MBA_WORD=${_MBA_VLLM_WORDS[$_MBA_I]}
  case "$_MBA_WORD" in
    --kv-cache-memory-bytes=17179869184)
      _MBA_WORD=--kv-cache-memory-bytes=15032385536
      _MBA_KV_FOUND=$((_MBA_KV_FOUND + 1)) ;;
    --kv-cache-memory-bytes=*|--kv-cache-memory=*)
      _MBA_KV_BAD=1 ;;
    --kv-cache-memory-bytes|--kv-cache-memory)
      if [ "$_MBA_WORD" != --kv-cache-memory-bytes ] \
         || [ "$((_MBA_I + 1))" -ge "${#_MBA_VLLM_WORDS[@]}" ] \
         || [ "${_MBA_VLLM_WORDS[$((_MBA_I + 1))]}" != 17179869184 ]; then
        _MBA_KV_BAD=1
      else
        _MBA_WORD=--kv-cache-memory-bytes=15032385536
        _MBA_KV_FOUND=$((_MBA_KV_FOUND + 1))
        _MBA_I=$((_MBA_I + 1))
      fi ;;
    --middleware|--middleware=*) _MBA_KV_BAD=1 ;;
  esac
  _MBA_VLLM_OUT+="${_MBA_VLLM_OUT:+ }$_MBA_WORD"
  _MBA_I=$((_MBA_I + 1))
done
if [ "$_MBA_KV_FOUND" != 1 ] || [ "$_MBA_KV_BAD" != 0 ]; then
  echo "memory-bounded candidate requires exactly one 16 GiB byte-form KV option and no middleware" >&2
  return 1
fi
_MBA_EXPECTED_VLLM='--kv-cache-memory-bytes=15032385536 --attention-backend B12X --moe-backend triton --linear-backend triton --scheduler-cls adaptive_k_scheduler.AdaptiveKScheduler --prefill-schedule-interval 8 --compilation-config={"max_cudagraph_capture_size":72}'
if [ "$_MBA_VLLM_OUT" != "$_MBA_EXPECTED_VLLM" ]; then
  echo "memory-bounded candidate requires the exact protected E31 engine arguments" >&2
  return 1
fi

EXTRA_DOCKER_ENV="${EXTRA_DOCKER_ENV} -e VLLM_PREFILL_CACHE_TRIM=1 -e VLLM_RESILIENCE_STEP_TOKEN_CAP=6912 -v \$HOME/tp4/experiments/e03/bounded-admission/middleware.py:$_MBA_ADMISSION_SITE:ro -e TP4_ADMISSION_MAX_ACTIVE=6 -e TP4_ADMISSION_MAX_QUEUED=128 -e TP4_ADMISSION_MAX_BODY_BYTES=8388608 -e TP4_ADMISSION_QUEUE_TIMEOUT_SECONDS=1800 -e TP4_ADMISSION_REQUEST_TIMEOUT_SECONDS=3600 -e TP4_ADMISSION_BODY_IDLE_SECONDS=30 -e TP4_ADMISSION_SEND_IDLE_SECONDS=30"
EXTRA_VLLM_ARGS="$_MBA_VLLM_OUT --middleware tp4_admission.BoundedAdmissionMiddleware"

unset _MBA_WORKER_SITE _MBA_SCHEDULER_SITE _MBA_ADMISSION_SITE _MBA_ADMISSION_TARGETS \
  _MBA_PREV _MBA_DOCKER_WORDS _MBA_WORD _MBA_KV_FOUND _MBA_KV_BAD _MBA_VLLM_OUT \
  _MBA_VLLM_WORDS _MBA_I _MBA_EXPECTED_VLLM
