  "selection": {
    "environment": {
      "TP4_ADMISSION_MAX_ACTIVE": "6",
      "TP4_ADMISSION_MAX_QUEUED": "128",
      "TP4_ADMISSION_MAX_BODY_BYTES": "8388608",
      "TP4_ADMISSION_QUEUE_TIMEOUT_SECONDS": "1800",
      "TP4_ADMISSION_REQUEST_TIMEOUT_SECONDS": "3600",
      "TP4_ADMISSION_BODY_IDLE_SECONDS": "30",
      "TP4_ADMISSION_SEND_IDLE_SECONDS": "30"
    }
  },
  "guard": {
    "mode": "all_post_except",
    "bypass_paths": [
      "/is_scaling_elastic_ep",
      "/ping",
      "/scale_elastic_ep"
    ],
    "bypass_pattern": "/v1/responses/{nonempty-single-segment}/cancel"
  },
  "limitations": [
    "Queued disconnects are observed only when admitted, timed out, externally cancelled or shut down because the middleware does not consume queued bodies.",
    "The limits bound middleware membership but do not bound transport buffers or memory retained inside vLLM.",
    "The selected values require mixed-load, cancellation and soak measurement before promotion."
  ]
