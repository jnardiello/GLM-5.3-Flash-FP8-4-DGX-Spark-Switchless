    "python": "3.12",
    "fastapi": "0.136.3",
    "starlette": "1.6.0",
    "registration": "vllm.entrypoints.serve.middleware.register"
  },
  "candidate": {
    "path": "scripts/node/experiments/e03/bounded-admission/middleware.py",
    "sha256": "3909b20d57752e4e68035bfe81f35490fe2dd763bf65f089b08d20374d97c6db",
    "mount_target": "/opt/tp4/tp4_admission.py",
    "import_string": "tp4_admission.BoundedAdmissionMiddleware"
