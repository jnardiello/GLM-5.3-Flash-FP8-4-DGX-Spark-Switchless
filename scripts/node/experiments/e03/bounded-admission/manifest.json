{
  "schema": "tp4-bounded-admission-candidate-v1",
  "status": "experimental_candidate",
  "summary": "Finite pre-parse admission queue and active-request bound for expensive rank-0 API routes.",
  "runtime": {
    "image": "ghcr.io/fujitsupolycom/sparkring-glm53-sparkcache@sha256:0d4029b3b7023cf32c37ac20279469c9a2ee16a057f25aae3bcfee9ee5fb660f",
