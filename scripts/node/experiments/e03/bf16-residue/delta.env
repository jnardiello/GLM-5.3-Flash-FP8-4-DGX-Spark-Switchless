# E21 BF16-residue candidate, as measured: a standalone TP4_ENV applied on top of the
# E03 recipe in cluster.env, with no other overlay. E21 was promoted on 2026-09-23 and the
# default cluster.env.example now encodes it, so this delta refuses the current default; it
# applies only to a site cluster.env that still holds the E03 recipe. It refuses the C5
# overlay because the comparison reference was measured at six sequences.
# Enter: down with the overlay that started the running stack, then deploy/up with this one.
# Return: down with this overlay, then deploy/up with the overlay the owner selected before
# the window. Use the same TP4_ENV for every command in the window; never change CONTAINER.
# The candidate changes the arithmetic of converted weights, so it also selects a
# distinct SparkCache namespace: the accepted E03 cache must not be reused.
if [ "${IMAGE-}" != "ghcr.io/fujitsupolycom/sparkring-glm53-sparkcache@sha256:0d4029b3b7023cf32c37ac20279469c9a2ee16a057f25aae3bcfee9ee5fb660f" ] \
   || [ "${IMAGE_ID-}" != "sha256:5e32aaa1bbe3559e81db7706ed4286248f18d27cfdb186f6b851bf786eb43075" ] \
   || [ "${SPARKCACHE_MODE-}" != on ] \
   || [ "${SPARKCACHE_CONNECTOR-}" != '$HOME/tp4/sparkcache/spark_context_cache_connector-e03-replay-views.py' ] \
   || [ "${SPARKCACHE_CONNECTOR_SHA256-}" != 5893f8747aa093874c46a0185f93c786265d99b5a4cd8da849a7471132422d66 ] \
   || [ "${SPARK_MHC_PREFILL_SHARD-}" != 1 ] \
   || [ "${MAX_MODEL_LEN-}" != 262144 ] \
   || [ "${MAX_NUM_SEQS-}" != 6 ]; then
  echo "E21 BF16 residue requires the accepted E03 image, replay views connector, mHC prefill sharding, 262144 context and max-num-seqs 6" >&2
  return 1
fi

read -r -a _E21_ARGS <<<"${EXTRA_VLLM_ARGS-}"
_E21_KV_COUNT=0
for _E21_ARG in "${_E21_ARGS[@]}"; do
  case "$_E21_ARG" in
    --kv-cache-memory-bytes=16106127360) _E21_KV_COUNT=$((_E21_KV_COUNT + 1)) ;;
    --kv-cache-memory-bytes=*|--kv-cache-memory=*)
      echo "E21 BF16 residue refuses a KV pool other than 16106127360 bytes per rank" >&2
      unset _E21_ARGS _E21_ARG _E21_KV_COUNT
      return 1 ;;
  esac
done
[ "$_E21_KV_COUNT" -eq 1 ] || {
  echo "E21 BF16 residue requires exactly one 16106127360-byte KV pool argument" >&2
  unset _E21_ARGS _E21_ARG _E21_KV_COUNT
  return 1
}
unset _E21_ARGS _E21_ARG _E21_KV_COUNT

_E21_HOOK=/usr/local/lib/python3.12/dist-packages/vllm/models/glm5next/nvidia/e20_kda_w8a16.py
_E21_OLD='-v $HOME/tp4/overrides/vllm/models/glm5next/nvidia/e20_kda_w8a16.py:/usr/local/lib/python3.12/dist-packages/vllm/models/glm5next/nvidia/e20_kda_w8a16.py:ro'
_E21_NEW='-v $HOME/tp4/experiments/e03/bf16-residue/e20_kda_w8a16.py:/usr/local/lib/python3.12/dist-packages/vllm/models/glm5next/nvidia/e20_kda_w8a16.py:ro'
[[ "$EXTRA_DOCKER_ENV" == *"$_E21_OLD"* &&
   "$EXTRA_DOCKER_ENV" == *"/e20_hybrid_scratch.py:"* &&
   "$EXTRA_DOCKER_ENV" != *e21_bf16_residue.py* &&
   "$EXTRA_DOCKER_ENV" != *VLLM_E21_BF16_RESIDUE_W8A16* ]] \
  || { echo "E21 BF16 residue requires the accepted E20 hook and scratch mounts, no residue mount and an unset residue flag" >&2; unset _E21_HOOK _E21_OLD _E21_NEW; return 1; }
_E21_REST="${EXTRA_DOCKER_ENV/$_E21_OLD/}"
[[ "$_E21_REST" != *":$_E21_HOOK:"* ]] \
  || { echo "E21 BF16 residue requires exactly one E20 hook mount" >&2; unset _E21_HOOK _E21_OLD _E21_NEW _E21_REST; return 1; }

[ "${SPARKCACHE_CONFIG_SHA256-}" = 9a0520e0dc71d7e8cf9045065cff78226296305b25f0bc010c7830bb82019ed5 ] \
  || { echo "E21 BF16 residue requires the accepted E03 cache config as the base of its distinct namespace" >&2; unset _E21_HOOK _E21_OLD _E21_NEW _E21_REST; return 1; }
SPARKCACHE_CONFIG='$HOME/tp4/experiments/e03/bf16-residue/kv-transfer-config.json'
SPARKCACHE_CONFIG_SHA256=548fe62a6676370261a3ddff27e81ac2cfd0d68b1cad4ee8bc99e1c832181e8c

EXTRA_DOCKER_ENV="${EXTRA_DOCKER_ENV/$_E21_OLD/$_E21_NEW}"
EXTRA_DOCKER_ENV+=' -v $HOME/tp4/experiments/e03/bf16-residue/e21_bf16_residue.py:/usr/local/lib/python3.12/dist-packages/vllm/models/glm5next/nvidia/e21_bf16_residue.py:ro'
EXTRA_DOCKER_ENV+=' -e VLLM_E21_BF16_RESIDUE_W8A16=1'
unset _E21_HOOK _E21_OLD _E21_NEW _E21_REST
