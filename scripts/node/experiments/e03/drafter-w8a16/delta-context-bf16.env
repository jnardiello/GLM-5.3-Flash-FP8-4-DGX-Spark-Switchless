# E22b drafter W8A16 candidate: a standalone TP4_ENV applied on top of the complete E21
# recipe (scripts/node/reference/baseline-20260923-e21.env), at six sequences like the E21
# reference. It converts 30 DFlash2 drafter linears to 8-bit weights and keeps the drafter's
# context K/V projection in BF16 (VLLM_E22_CONTEXT_KV_W8A16=0). E22b was promoted on
# 2026-09-23: cluster.env.example now encodes it, so this overlay refuses the current default
# and is the record of the measured candidate. It selects its own SparkCache namespace
# because the converted drafter changes the cached drafter state.
if [ "${IMAGE-}" != "ghcr.io/fujitsupolycom/sparkring-glm53-sparkcache@sha256:0d4029b3b7023cf32c37ac20279469c9a2ee16a057f25aae3bcfee9ee5fb660f" ] \
   || [ "${IMAGE_ID-}" != "sha256:5e32aaa1bbe3559e81db7706ed4286248f18d27cfdb186f6b851bf786eb43075" ] \
   || [ "${SPARKCACHE_MODE-}" != on ] \
   || [ "${SPARKCACHE_CONNECTOR-}" != '$HOME/tp4/sparkcache/spark_context_cache_connector-e03-replay-views.py' ] \
   || [ "${SPARKCACHE_CONNECTOR_SHA256-}" != 5893f8747aa093874c46a0185f93c786265d99b5a4cd8da849a7471132422d66 ] \
   || [ "${SPARK_MHC_PREFILL_SHARD-}" != 1 ] \
   || [ "${MAX_MODEL_LEN-}" != 262144 ] \
   || [ "${MAX_NUM_SEQS-}" != 6 ]; then
  echo "E22 drafter W8A16 requires the accepted E21 image, replay views connector, mHC prefill sharding, 262144 context and max-num-seqs 6" >&2
  return 1
fi

read -r -a _E22_ARGS <<<"${EXTRA_VLLM_ARGS-}"
_E22_KV_COUNT=0
for _E22_ARG in "${_E22_ARGS[@]}"; do
  case "$_E22_ARG" in
    --kv-cache-memory-bytes=16106127360) _E22_KV_COUNT=$((_E22_KV_COUNT + 1)) ;;
    --kv-cache-memory-bytes=*|--kv-cache-memory=*)
      echo "E22 drafter W8A16 refuses a KV pool other than 16106127360 bytes per rank" >&2
      unset _E22_ARGS _E22_ARG _E22_KV_COUNT
      return 1 ;;
  esac
done
[ "$_E22_KV_COUNT" -eq 1 ] || {
  echo "E22 drafter W8A16 requires exactly one 16106127360-byte KV pool argument" >&2
  unset _E22_ARGS _E22_ARG _E22_KV_COUNT
  return 1
}
unset _E22_ARGS _E22_ARG _E22_KV_COUNT

_E22_E21='-v $HOME/tp4/experiments/e03/bf16-residue/e21_bf16_residue.py:/usr/local/lib/python3.12/dist-packages/vllm/models/glm5next/nvidia/e21_bf16_residue.py:ro'
[[ "$EXTRA_DOCKER_ENV" == *"$_E22_E21"* &&
   "$EXTRA_DOCKER_ENV" == *" -e VLLM_E21_BF16_RESIDUE_W8A16=1"* &&
   "$EXTRA_DOCKER_ENV" == *"/e20_hybrid_scratch.py:"* &&
   "$EXTRA_DOCKER_ENV" != *qwen3_dflash2.py* &&
   "$EXTRA_DOCKER_ENV" != *e22_drafter_w8a16.py* &&
   "$EXTRA_DOCKER_ENV" != *VLLM_E22_DRAFTER_W8A16* &&
   "$EXTRA_DOCKER_ENV" != *VLLM_E22_CONTEXT_KV_W8A16* ]] \
  || { echo "E22 drafter W8A16 requires the accepted E21 module and flag, and no drafter override or E22 flag" >&2; unset _E22_E21; return 1; }

[ "${SPARKCACHE_CONFIG_SHA256-}" = 548fe62a6676370261a3ddff27e81ac2cfd0d68b1cad4ee8bc99e1c832181e8c ] \
  || { echo "E22 drafter W8A16 requires the accepted E21 cache config as the base of its distinct namespace" >&2; unset _E22_E21; return 1; }
SPARKCACHE_CONFIG='$HOME/tp4/experiments/e03/drafter-w8a16/kv-transfer-config-e22b.json'
SPARKCACHE_CONFIG_SHA256=f7d8989486907766c8df7ceaf67731fd2ec95e3bf474a6f63bb4303e41fbe4bc

EXTRA_DOCKER_ENV+=' -v $HOME/tp4/experiments/e03/drafter-w8a16/qwen3_dflash2.py:/usr/local/lib/python3.12/dist-packages/vllm/model_executor/models/qwen3_dflash2.py:ro'
EXTRA_DOCKER_ENV+=' -v $HOME/tp4/experiments/e03/drafter-w8a16/e22_drafter_w8a16.py:/usr/local/lib/python3.12/dist-packages/vllm/models/glm5next/nvidia/e22_drafter_w8a16.py:ro'
EXTRA_DOCKER_ENV+=' -e VLLM_E22_DRAFTER_W8A16=1'
EXTRA_DOCKER_ENV+=' -e VLLM_E22_CONTEXT_KV_W8A16=0'
unset _E22_E21
