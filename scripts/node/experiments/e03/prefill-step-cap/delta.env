# Diagnostic step-token cap applied on top of the protected E31 default. It replaces
# exactly the E29 scheduler mount and preserves the prefill-cache-trim worker selection.
_PSC_SITE=/usr/local/lib/python3.12/dist-packages/vllm/v1/core/sched/scheduler.py
_PSC_FROM="\$HOME/tp4/experiments/e03/end-drain/scheduler.py:$_PSC_SITE:ro"
_PSC_TO="\$HOME/tp4/experiments/e03/prefill-step-cap/scheduler.py:$_PSC_SITE:ro"
if [ "${BATCHED_TOKENS-}" != 8192 ] || [ "${BLOCK_SIZE-}" != 2304 ] \
   || [[ "${EXTRA_DOCKER_ENV-}" == *$'\n'* ]]; then
  echo "prefill-step-cap requires the E31 8192-token budget, 2304-token block and one-line Docker arguments" >&2
  unset _PSC_SITE _PSC_FROM _PSC_TO
  return 1
fi

read -r -a _PSC_WORDS <<<"${EXTRA_DOCKER_ENV-}"
_PSC_PREV= _PSC_OUT= _PSC_FOUND=0 _PSC_TARGETS=0 _PSC_BAD=0
for _PSC_WORD in "${_PSC_WORDS[@]}"; do
  if [ "$_PSC_PREV" = -e ]; then
    case "$_PSC_WORD" in VLLM_RESILIENCE_STEP_TOKEN_CAP*) _PSC_BAD=1 ;; esac
  elif [ "$_PSC_PREV" = -v ]; then
    case "$_PSC_WORD" in
      *":$_PSC_SITE"|*":$_PSC_SITE:"*) _PSC_TARGETS=$((_PSC_TARGETS + 1)) ;;
      */prefill-step-cap/*) _PSC_BAD=1 ;;
    esac
    if [ "$_PSC_WORD" = "$_PSC_FROM" ]; then
      _PSC_WORD=$_PSC_TO
      _PSC_FOUND=$((_PSC_FOUND + 1))
    fi
  fi
  _PSC_OUT+="${_PSC_OUT:+ }$_PSC_WORD"
  _PSC_PREV=$_PSC_WORD
done
if [ "$_PSC_FOUND" != 1 ] || [ "$_PSC_TARGETS" != 1 ] || [ "$_PSC_BAD" != 0 ]; then
  echo "prefill-step-cap requires exactly one E29 scheduler mount and no prior cap selection" >&2
  unset _PSC_SITE _PSC_FROM _PSC_TO _PSC_WORDS _PSC_WORD _PSC_PREV _PSC_OUT \
    _PSC_FOUND _PSC_TARGETS _PSC_BAD
  return 1
fi
EXTRA_DOCKER_ENV="$_PSC_OUT -e VLLM_RESILIENCE_STEP_TOKEN_CAP=6912"
unset _PSC_SITE _PSC_FROM _PSC_TO _PSC_WORDS _PSC_WORD _PSC_PREV _PSC_OUT \
  _PSC_FOUND _PSC_TARGETS _PSC_BAD
