+_RESILIENCE_STEP_TOKEN_CAP = 6912
+_RESILIENCE_CONFIGURED_TOKEN_BUDGET = 8192
+_RESILIENCE_CACHE_BLOCK_SIZE = 2304
+_RESILIENCE_EAGER_THRESHOLD = 72
+
+
+def _resilience_step_token_cap() -> int:
+    """Parse the diagnostic as an exact opt-in; zero preserves E29."""
+    value = os.environ.get("VLLM_RESILIENCE_STEP_TOKEN_CAP", "0")
+    if value == "0":
+        return 0
+    if value != str(_RESILIENCE_STEP_TOKEN_CAP):
+        raise ValueError(
+            "VLLM_RESILIENCE_STEP_TOKEN_CAP must be 0 or 6912, "
+            f"got {value!r}"
+        )
+    return _RESILIENCE_STEP_TOKEN_CAP
+
+
+def _resilience_effective_token_budget(configured: int, cap: int) -> int:
+    """Return the target-token budget for one scheduler output."""
+    if configured <= 0 or cap < 0:
+        raise ValueError("scheduler token budgets must be positive")
+    return min(configured, cap) if cap else configured
+
+
+def _resilience_step_receipt(
+    *,
+    schedule_sequence: int,
+    scheduled_target_tokens: int,
+    num_scheduled_new_requests: int,
+    configured_token_budget: int,
+    effective_token_cap: int,
+    wall_time_ns=time.time_ns,
+    monotonic_ns=time.monotonic_ns,
+    pid_fn=os.getpid,
+) -> dict[str, int | str]:
+    """Build one bounded receipt for an eager scheduler output."""
+    return {
+        "schema": "prefill-step-cap-v1",
+        "wall_time_ns": wall_time_ns(),
+        "monotonic_ns": monotonic_ns(),
+        "pid": pid_fn(),
+        "schedule_sequence": schedule_sequence,
+        "scheduled_target_tokens": scheduled_target_tokens,
+        "num_scheduled_new_requests": num_scheduled_new_requests,
+        "configured_token_budget": configured_token_budget,
+        "effective_token_cap": effective_token_cap,
+    }
 
 
