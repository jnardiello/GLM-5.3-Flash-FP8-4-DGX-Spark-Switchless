# Fidelity campaign overlay `r0fp8-m-nospec` (generated by scripts/fidelity/make_overlays.py; do not edit).
# R0 reference and ladder rung 1: September 18 recipe (BF16 KDA projections, no hybrid KDA, no mHC, no E21/E22b) with its FP8 KV; B12X admits no BF16 KV (PLAN amendment 6) — speculative decoding OFF.
# Complete non-site recipe: base scripts/node/reference/baseline-20260918.env (non-site keys), deltas: SPARKCACHE_CONFIG, SPARKCACHE_CONFIG_SHA256, MAX_MODEL_LEN, MAX_NUM_SEQS, SPEC_TOKENS, SPEC_EXTRA_JSON, EXTRA_VLLM_ARGS.
# SparkCache: reference/sparkcache-20260918.json with spark_cache_root changed to a fidelity namespace and store/restore off (measurement).
# Use the same TP4_ENV for deploy, up, status and down in its window. See docs/fidelity/PLAN.md.
NCCL_IB_GID_INDEX=-1
NCCL_IB_GID_INDEX_BY_RANK=()
IMAGE=ghcr.io/fujitsupolycom/sparkring-glm53-sparkcache@sha256:0d4029b3b7023cf32c37ac20279469c9a2ee16a057f25aae3bcfee9ee5fb660f
IMAGE_ID=sha256:5e32aaa1bbe3559e81db7706ed4286248f18d27cfdb186f6b851bf786eb43075
LAUNCHER=launch-glm53-tp4.sh
SPARKCACHE_MODE=on
SPARKCACHE_CONFIG='$HOME/tp4/experiments/fidelity/sparkcache/r0fp8-m-nospec.json'
SPARKCACHE_CONFIG_SHA256=c1dc6c337d23f71fb7e96618fcdfd2e1f426b435d4706e9b6f9f543bdad9d2bb
SPARKCACHE_CONNECTOR='$HOME/tp4/sparkcache/spark_context_cache_connector-20260918.py'
SPARKCACHE_CONNECTOR_SHA256=a0bedc1c33a316d3c56ae857652c4a17acac9a82b053a4a71689684f33b75745
SPARKCACHE_ENCODER=''
SPARKCACHE_ENCODER_SHA256=''
SIRCL_DIR='$HOME/tp4/sircl'
MODEL_DIR='$HOME/glm53-flash-fp8-zai'
MODEL_REPO=zai-org/GLM-5.3-Flash
MODEL_REV="690b705278a3a58e538fcb37c2ca8b5f9511213c"
DRAFT_DIR='$HOME/glm53-dflash2-draft'
DRAFT_REV="bf582e4eacc1810f76656d1811693ff6c6737d2a"
SERVED_NAME=glm-5.3-flash
MAX_MODEL_LEN=139264
MAX_NUM_SEQS=1
KV_CACHE_DTYPE=fp8_e4m3
BATCHED_TOKENS=8192
SPARK_MHC_PREFILL_SHARD=0
BLOCK_SIZE=2304
GPU_MEM_UTIL=0.85
SPEC_TOKENS=0
SPEC_EXTRA_JSON=''
ASYNC_SCHEDULING=0
EXTRA_DOCKER_ENV='-v $HOME/tp4/moe-configs/E=288,N=512,device_name=NVIDIA_GB10,dtype=fp8_w8a8,block_shape=[128,128].json:/usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/fused_moe/configs/E=288,N=512,device_name=NVIDIA_GB10,dtype=fp8_w8a8,block_shape=[128,128].json:ro -v $HOME/patches/adaptive_k_scheduler.py:/opt/tp4/adaptive_k_scheduler.py:ro -e PYTHONPATH=/opt/tp4 -e VLLM_ADAPTIVE_K_MODE=batch-uniform -e VLLM_ADAPTIVE_K_SEED=1.0 -e VLLM_ADAPTIVE_K_DOWN=0.42 -e VLLM_ADAPTIVE_K_UP=0.58 -e VLLM_ADAPTIVE_K_ALPHA=0.15 -e VLLM_ADAPTIVE_K_SIGNAL=pos -v $HOME/tp4/overrides/vllm/v1/kv_cache_interface.py:/usr/local/lib/python3.12/dist-packages/vllm/v1/kv_cache_interface.py:ro -v $HOME/tp4/overrides/vllm/v1/core/kv_cache_utils.py:/usr/local/lib/python3.12/dist-packages/vllm/v1/core/kv_cache_utils.py:ro -v $HOME/tp4/overrides/vllm/v1/worker/utils.py:/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/utils.py:ro -v $HOME/tp4/overrides/vllm/models/glm5next/nvidia/ops/glm_kpool.py:/usr/local/lib/python3.12/dist-packages/vllm/models/glm5next/nvidia/ops/glm_kpool.py:ro -v $HOME/tp4/reference/model-20260918.py:/usr/local/lib/python3.12/dist-packages/vllm/models/glm5next/nvidia/model.py:ro -v $HOME/tp4/overrides/vllm/models/glm5next/nvidia/pooled_indexer.py:/usr/local/lib/python3.12/dist-packages/vllm/models/glm5next/nvidia/pooled_indexer.py:ro -v $HOME/tp4/sircl/bundle:/opt/spark-sircl:ro -v $HOME/tp4/sircl/runtime:/opt/sircl-serving:ro --entrypoint /opt/sircl-serving/entrypoint.sh -v $HOME/tp4/sparkcache/spark_context_cache_connector-20260918.py:/usr/local/lib/python3.12/dist-packages/sparkcache/spark_context_cache_connector.py:ro'
EXTRA_VLLM_ARGS="--kv-cache-memory-bytes=6442450944 --attention-backend B12X --moe-backend triton --linear-backend triton --scheduler-cls adaptive_k_scheduler.AdaptiveKScheduler --max-logprobs 100"
