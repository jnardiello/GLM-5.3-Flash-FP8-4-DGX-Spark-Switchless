# Fidelity campaign overlay `le36-m` (generated by scripts/fidelity/make_overlays.py; do not edit).
# E36 in measurement mode: the E35 default plus the INT8 shared lm_head, BF16 kept and selected per call by /tmp/glm53-e36-lm-head (bf16 scores Cnow, int8 scores LE36, on one load).
# Complete non-site recipe: base cluster.env.example + scripts/node/experiments/e03/e36-lm-head-w8a16/delta.env (evaluated) (non-site keys), deltas: SPARKCACHE_CONFIG, SPARKCACHE_CONFIG_SHA256, MAX_MODEL_LEN, MAX_NUM_SEQS, EXTRA_VLLM_ARGS.
# SparkCache: experiments/e03/sparkcache-ram-budget/kv-transfer-config.json with spark_cache_root changed to a fidelity namespace and store/restore off (measurement).
# Use the same TP4_ENV for deploy, up, status and down in its window. See docs/fidelity/PLAN.md.
NCCL_IB_GID_INDEX='-1'
NCCL_IB_GID_INDEX_BY_RANK=()
IMAGE='ghcr.io/fujitsupolycom/sparkring-glm53-sparkcache@sha256:0d4029b3b7023cf32c37ac20279469c9a2ee16a057f25aae3bcfee9ee5fb660f'
IMAGE_ID='sha256:5e32aaa1bbe3559e81db7706ed4286248f18d27cfdb186f6b851bf786eb43075'
LAUNCHER='launch-glm53-tp4.sh'
SPARKCACHE_MODE='on'
SPARKCACHE_CONFIG='$HOME/tp4/experiments/fidelity/sparkcache/le36-m.json'
SPARKCACHE_CONFIG_SHA256=6fee708a07f219d5d9d0d845914f2912768f5c3ed4d01adc731231a5527e17e5
SPARKCACHE_CONNECTOR='$HOME/tp4/sparkcache/spark_context_cache_connector-ram-budget.py'
