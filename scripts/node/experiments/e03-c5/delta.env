# Current-E03 C5 functionality delta. Use this TP4_ENV for every lifecycle command
# in the window; return with a coordinated down, then deploy/up without TP4_ENV.
if [ "${IMAGE-}" != "ghcr.io/fujitsupolycom/sparkring-glm53-sparkcache@sha256:0d4029b3b7023cf32c37ac20279469c9a2ee16a057f25aae3bcfee9ee5fb660f" ] \
   || [ "${IMAGE_ID-}" != "sha256:5e32aaa1bbe3559e81db7706ed4286248f18d27cfdb186f6b851bf786eb43075" ] \
   || [ "${SPARKCACHE_MODE-}" != on ] \
   || [ "${SPARKCACHE_CONFIG-}" != '$HOME/tp4/experiments/e03/kv-transfer-config.json' ] \
   || [ "${SPARKCACHE_CONFIG_SHA256-}" != 9a0520e0dc71d7e8cf9045065cff78226296305b25f0bc010c7830bb82019ed5 ] \
   || [ "${SPARKCACHE_CONNECTOR-}" != '$HOME/tp4/sparkcache/spark_context_cache_connector-e03-replay-views.py' ] \
   || [ "${SPARKCACHE_CONNECTOR_SHA256-}" != 5893f8747aa093874c46a0185f93c786265d99b5a4cd8da849a7471132422d66 ] \
   || [ "${SPARK_MHC_PREFILL_SHARD-}" != 1 ] \
   || [ "${MAX_MODEL_LEN-}" != 262144 ] \
   || [ "${MAX_NUM_SEQS-}" != 6 ]; then
  echo "E03 C5 requires the accepted E03 image, replay connector, 262144 context and max-num-seqs 6 base" >&2
  return 1
fi

read -r -a _E03_C5_ARGS <<<"${EXTRA_VLLM_ARGS-}"
_E03_C5_KV_COUNT=0
for _E03_C5_ARG in "${_E03_C5_ARGS[@]}"; do
  case "$_E03_C5_ARG" in
    --kv-cache-memory-bytes=16106127360) _E03_C5_KV_COUNT=$((_E03_C5_KV_COUNT + 1)) ;;
    --kv-cache-memory-bytes=*|--kv-cache-memory=*)
      echo "E03 C5 refuses a KV pool other than 16106127360 bytes per rank" >&2
      unset _E03_C5_ARGS _E03_C5_ARG _E03_C5_KV_COUNT
      return 1 ;;
  esac
done
[ "$_E03_C5_KV_COUNT" -eq 1 ] || {
  echo "E03 C5 requires exactly one 16106127360-byte KV pool argument" >&2
  unset _E03_C5_ARGS _E03_C5_ARG _E03_C5_KV_COUNT
  return 1
}
unset _E03_C5_ARGS _E03_C5_ARG _E03_C5_KV_COUNT

MAX_NUM_SEQS=5
