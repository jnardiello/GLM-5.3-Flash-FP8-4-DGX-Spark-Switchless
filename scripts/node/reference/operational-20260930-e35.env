# One-step return from the E36 default to E35: the shared lm_head stays BF16. Source after
# cluster.env and use the same TP4_ENV for the whole window, including down. It swaps the E36
# runner mount back to the E35 runner and removes exactly the E36 module mount and its two
# variables; it refuses any other E36 form, --volume/--mount/--env-file forms and a second
# runner mount, so the launcher command equals the E35 command on all four ranks.
_E6R_VLLM=/usr/local/lib/python3.12/dist-packages/vllm
_E6R_RUNNER_E36="\$HOME/tp4/experiments/e03/e36-lm-head-w8a16/model_runner.py:$_E6R_VLLM/v1/worker/gpu/model_runner.py:ro"
_E6R_RUNNER_E35="\$HOME/tp4/experiments/e03/e35-runner-k/model_runner.py:$_E6R_VLLM/v1/worker/gpu/model_runner.py:ro"
_E6R_DROP=("\$HOME/tp4/experiments/e03/e36-lm-head-w8a16/e36_lm_head_w8a16.py:$_E6R_VLLM/models/glm5next/nvidia/e36_lm_head_w8a16.py:ro"
           VLLM_E36_LM_HEAD_W8A16=1 VLLM_E36_KEEP_BF16=0)
_E6R_CLEAN() {
  unset _E6R_VLLM _E6R_RUNNER_E36 _E6R_RUNNER_E35 _E6R_DROP _E6R_WORDS _E6R_OUT _E6R_SWAP _E6R_HITS \
    _E6R_INDEX _E6R_WORD _E6R_NEXT _E6R_MATCH _E6R_I _E6R_BAD _E6R_OPAQUE _E6R_TARGETS
  unset -f _E6R_CLEAN
}
if [[ "${EXTRA_DOCKER_ENV-}" == *$'\n'* ]]; then
  echo "E35 return refuses multiline Docker arguments" >&2; _E6R_CLEAN; return 1
fi
read -r -a _E6R_WORDS <<<"${EXTRA_DOCKER_ENV-}"
_E6R_OUT= _E6R_SWAP=0 _E6R_HITS=() _E6R_INDEX=0 _E6R_OPAQUE=0
for _E6R_WORD in "${_E6R_DROP[@]}"; do _E6R_HITS+=(0); done
while [ "$_E6R_INDEX" -lt "${#_E6R_WORDS[@]}" ]; do
  _E6R_WORD=${_E6R_WORDS[$_E6R_INDEX]}
  _E6R_NEXT=${_E6R_WORDS[$((_E6R_INDEX + 1))]-}
  case "$_E6R_WORD" in
    --volume|--volume=*|--mount|--mount=*|--env-file|--env-file=*) _E6R_OPAQUE=$((_E6R_OPAQUE + 1)) ;;
  esac
  if { [ "$_E6R_WORD" = -v ] || [ "$_E6R_WORD" = -e ]; } && [ -n "$_E6R_NEXT" ]; then
    _E6R_MATCH=-1
    for _E6R_I in "${!_E6R_DROP[@]}"; do
      [ "$_E6R_NEXT" = "${_E6R_DROP[$_E6R_I]}" ] && _E6R_MATCH=$_E6R_I
    done
    if [ "$_E6R_MATCH" -ge 0 ]; then
      _E6R_HITS[$_E6R_MATCH]=$((_E6R_HITS[$_E6R_MATCH] + 1))
      _E6R_INDEX=$((_E6R_INDEX + 2)); continue
    fi
    if [ "$_E6R_WORD" = -v ] && [ "$_E6R_NEXT" = "$_E6R_RUNNER_E36" ]; then
      _E6R_SWAP=$((_E6R_SWAP + 1))
      _E6R_OUT+="${_E6R_OUT:+ }-v $_E6R_RUNNER_E35"
      _E6R_INDEX=$((_E6R_INDEX + 2)); continue
    fi
  fi
  _E6R_OUT+="${_E6R_OUT:+ }$_E6R_WORD"
  _E6R_INDEX=$((_E6R_INDEX + 1))
done
_E6R_BAD=0
[ "$_E6R_SWAP" = 1 ] || _E6R_BAD=1
[ "$_E6R_OPAQUE" = 0 ] || _E6R_BAD=1
for _E6R_I in "${!_E6R_HITS[@]}"; do [ "${_E6R_HITS[$_E6R_I]}" = 1 ] || _E6R_BAD=1; done
case " $_E6R_OUT " in *e36-lm-head-w8a16*|*VLLM_E36_*|*e36_lm_head_w8a16*) _E6R_BAD=1 ;; esac
# Exactly one mount may target the model runner after the swap.
read -r -a _E6R_WORDS <<<"$_E6R_OUT"
_E6R_TARGETS=0
for _E6R_I in "${!_E6R_WORDS[@]}"; do
  if [ "${_E6R_WORDS[$_E6R_I]}" = -v ]; then
    case "${_E6R_WORDS[$((_E6R_I + 1))]-}" in
      *":$_E6R_VLLM/v1/worker/gpu/model_runner.py"|*":$_E6R_VLLM/v1/worker/gpu/model_runner.py:"*) _E6R_TARGETS=$((_E6R_TARGETS + 1)) ;;
    esac
  fi
done
[ "$_E6R_TARGETS" = 1 ] || _E6R_BAD=1
if [ "$_E6R_BAD" != 0 ]; then
  echo "E35 return requires exactly the default E36 runner, module and variables" >&2
  _E6R_CLEAN; return 1
fi
EXTRA_DOCKER_ENV=$_E6R_OUT
_E6R_CLEAN
