# Frozen, portable F0 runtime overlay. Source this only after a site cluster.env.
# Site topology, node aliases, addresses, interfaces and CONTAINER remain owned by
# cluster.env. This file intentionally does not override CONTAINER.
F0_REFERENCE_ID=f0-20260912

IMAGE=ghcr.io/tonyd2wild/vllm-glm53-flash:sm121-v11-dflash2
LAUNCHER=launch-glm53-tp4.sh
MODEL_DIR='$HOME/glm53-flash-fp8-zai'
MODEL_REPO=zai-org/GLM-5.3-Flash
MODEL_REV=690b705278a3a58e538fcb37c2ca8b5f9511213c
DRAFT_DIR='$HOME/glm53-dflash2-draft'
DRAFT_REV=bf582e4eacc1810f76656d1811693ff6c6737d2a
PATCH_FILE='$HOME/patches/sparse_attn_indexer_kpool.py'
NCCL_DIR='$HOME/nccl-patched'
CACHE_DIR='$HOME/vllm-cache'
SERVED_NAME=glm-5.3-flash

MAX_MODEL_LEN=262144
MAX_NUM_SEQS=6
KV_CACHE_DTYPE=fp8_e4m3
BATCHED_TOKENS=8192
BLOCK_SIZE=2304
GPU_MEM_UTIL=0.85
SPEC_TOKENS=5
SPEC_EXTRA_JSON='"num_speculative_tokens_per_batch_size":[[1,1,5],[2,6,3]]'
ASYNC_SCHEDULING=0

# F0 uses automatic per-HCA IPv4 RoCEv2 selection. Clear any site rank array so
# this scalar wins on every rank. HCA names themselves remain site-owned.
NCCL_IB_GID_INDEX=-1
NCCL_IB_GID_INDEX_BY_RANK=()

EXTRA_DOCKER_ENV='-v $HOME/tp4/moe-configs/E=288,N=512,device_name=NVIDIA_GB10,dtype=fp8_w8a8,block_shape=[128,128].json:/usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/fused_moe/configs/E=288,N=512,device_name=NVIDIA_GB10,dtype=fp8_w8a8,block_shape=[128,128].json:ro -v $HOME/patches/adaptive_k_scheduler.py:/opt/tp4/adaptive_k_scheduler.py:ro -e PYTHONPATH=/opt/tp4 -e VLLM_ADAPTIVE_K_MODE=per-request -e VLLM_ADAPTIVE_K_SEED=1.0 -e VLLM_ADAPTIVE_K_DOWN=0.42 -e VLLM_ADAPTIVE_K_UP=0.58 -e VLLM_ADAPTIVE_K_ALPHA=0.15 -e VLLM_ADAPTIVE_K_SIGNAL=pos'
EXTRA_VLLM_ARGS='--kv-cache-memory=17179869184 --moe-backend triton --scheduler-cls adaptive_k_scheduler.AdaptiveKScheduler'

# These are verification pins. The launcher consumes IMAGE above; the reference
# verifier requires its locally resolved digest and the exact deployed artifacts.
F0_IMAGE_DIGEST='ghcr.io/tonyd2wild/vllm-glm53-flash@sha256:4def0ef644cb2e9814136dcffd5e385e21bc594f48f3b292234051904abe85a6'
F0_BASELINE_SHA256=5828ae600458d09219df94d920193b7cd29c32530380284e616aef104755048d
F0_LAUNCHER_SHA256=4ee95668acba3aa7693c7cf1efa584499fead443cbb9498eeb18f18587d36401
F0_CONTROLLER_SHA256=6cb6f07cc60a13c86dfed8c01156c13d3f1fb88ca611bd499989841f96688a82
F0_NCCL_SHA256=1ddc3240396a9b3a1e4fa3e54e129d099261106ce3b9263ac3fdc3e070713bd5
F0_NCCL_SIZE=61581280
