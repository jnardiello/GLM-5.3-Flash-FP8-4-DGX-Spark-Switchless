# Complete non-site September 19 E03 recipe: the immediate rollback from the E21 default.
# Source after cluster.env; preserve topology, site paths and container identity.
# Use the same TP4_ENV for deploy and all commands in the authorized window.
NCCL_IB_GID_INDEX=-1
NCCL_IB_GID_INDEX_BY_RANK=()
IMAGE=ghcr.io/fujitsupolycom/sparkring-glm53-sparkcache@sha256:0d4029b3b7023cf32c37ac20279469c9a2ee16a057f25aae3bcfee9ee5fb660f
IMAGE_ID=sha256:5e32aaa1bbe3559e81db7706ed4286248f18d27cfdb186f6b851bf786eb43075
LAUNCHER=launch-glm53-tp4.sh
SPARKCACHE_MODE=on
SPARKCACHE_CONFIG='$HOME/tp4/experiments/e03/kv-transfer-config.json'
SPARKCACHE_CONFIG_SHA256=9a0520e0dc71d7e8cf9045065cff78226296305b25f0bc010c7830bb82019ed5
SPARKCACHE_CONNECTOR='$HOME/tp4/sparkcache/spark_context_cache_connector-e03-replay-views.py'
SPARKCACHE_CONNECTOR_SHA256=5893f8747aa093874c46a0185f93c786265d99b5a4cd8da849a7471132422d66
SPARKCACHE_ENCODER='$HOME/tp4/sparkcache/spark_context_cache_hybrid.py'
SPARKCACHE_ENCODER_SHA256=11a2db855306b816a4f3d377d04207cc2d62112a381bcc54162099248bbf75f6
SIRCL_DIR='$HOME/tp4/sircl'
MODEL_REPO=zai-org/GLM-5.3-Flash
MODEL_REV="690b705278a3a58e538fcb37c2ca8b5f9511213c"
DRAFT_REV="bf582e4eacc1810f76656d1811693ff6c6737d2a"
SERVED_NAME=glm-5.3-flash
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=6
KV_CACHE_DTYPE=fp8_e4m3
BATCHED_TOKENS=8192
SPARK_MHC_PREFILL_SHARD=1
BLOCK_SIZE=2304
GPU_MEM_UTIL=0.85
SPEC_TOKENS=5
SPEC_EXTRA_JSON='"num_speculative_tokens_per_batch_size":[[1,1,5],[2,6,3]],"kv_cache_dtype":"fp8_e4m3"'
ASYNC_SCHEDULING=0
EXTRA_DOCKER_ENV='-v $HOME/tp4/moe-configs/E=288,N=512,device_name=NVIDIA_GB10,dtype=fp8_w8a8,block_shape=[128,128].json:/usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/fused_moe/configs/E=288,N=512,device_name=NVIDIA_GB10,dtype=fp8_w8a8,block_shape=[128,128].json:ro -v $HOME/tp4/experiments/e03/draft-budget/adaptive_k_scheduler.py:/opt/tp4/adaptive_k_scheduler.py:ro -e PYTHONPATH=/opt/tp4 -e VLLM_ADAPTIVE_K_MODE=batch-uniform -e VLLM_ADAPTIVE_K_SEED=1.0 -e VLLM_ADAPTIVE_K_DOWN=0.42 -e VLLM_ADAPTIVE_K_UP=0.58 -e VLLM_ADAPTIVE_K_ALPHA=0.15 -e VLLM_ADAPTIVE_K_SIGNAL=pos -v $HOME/tp4/overrides/vllm/v1/kv_cache_interface.py:/usr/local/lib/python3.12/dist-packages/vllm/v1/kv_cache_interface.py:ro -v $HOME/tp4/overrides/vllm/v1/core/kv_cache_utils.py:/usr/local/lib/python3.12/dist-packages/vllm/v1/core/kv_cache_utils.py:ro -v $HOME/tp4/overrides/vllm/v1/worker/utils.py:/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/utils.py:ro -v $HOME/tp4/overrides/vllm/models/glm5next/nvidia/ops/glm_kpool.py:/usr/local/lib/python3.12/dist-packages/vllm/models/glm5next/nvidia/ops/glm_kpool.py:ro  -v $HOME/tp4/overrides/vllm/models/glm5next/nvidia/pooled_indexer.py:/usr/local/lib/python3.12/dist-packages/vllm/models/glm5next/nvidia/pooled_indexer.py:ro -v $HOME/tp4/sircl/bundle:/opt/spark-sircl:ro -v $HOME/tp4/sircl/runtime:/opt/sircl-serving:ro --entrypoint /opt/sircl-serving/entrypoint.sh -v $HOME/tp4/sparkcache/spark_context_cache_connector-e03-replay-views.py:/usr/local/lib/python3.12/dist-packages/sparkcache/spark_context_cache_connector.py:ro -v $HOME/tp4/overrides/vllm/models/glm5next/nvidia/e20_kda_w8a16.py:/usr/local/lib/python3.12/dist-packages/vllm/models/glm5next/nvidia/e20_kda_w8a16.py:ro -v $HOME/tp4/overrides/vllm/models/glm5next/nvidia/e20_hybrid_scratch.py:/usr/local/lib/python3.12/dist-packages/vllm/models/glm5next/nvidia/e20_hybrid_scratch.py:ro -v $HOME/tp4/sparkcache/spark_context_cache_hybrid.py:/usr/local/lib/python3.12/dist-packages/sparkcache/spark_context_cache_hybrid.py:ro -v $HOME/tp4/overrides/vllm/v1/worker/gpu_worker.py:/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu_worker.py:ro -v $HOME/tp4/experiments/e03/overrides/vllm/model_executor/layers/fused_moe/runner/moe_runner.py:/usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/fused_moe/runner/moe_runner.py:ro -v $HOME/tp4/experiments/e03/overrides/vllm/model_executor/layers/fused_moe/runner/moe_runner_interface.py:/usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/fused_moe/runner/moe_runner_interface.py:ro -v $HOME/tp4/experiments/e03/overrides/vllm/model_executor/layers/linear.py:/usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/linear.py:ro -v $HOME/tp4/experiments/e03/overrides/vllm/model_executor/layers/mamba/gdn/kimi_gdn_linear_attn.py:/usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/mamba/gdn/kimi_gdn_linear_attn.py:ro -v $HOME/tp4/experiments/e03/overrides/vllm/model_executor/layers/mla.py:/usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/mla.py:ro -v $HOME/tp4/experiments/e03/overrides/vllm/models/glm5next/nvidia/attention.py:/usr/local/lib/python3.12/dist-packages/vllm/models/glm5next/nvidia/attention.py:ro -v $HOME/tp4/experiments/e03/overrides/vllm/models/glm5next/nvidia/kda.py:/usr/local/lib/python3.12/dist-packages/vllm/models/glm5next/nvidia/kda.py:ro -v $HOME/tp4/experiments/e03/overrides/vllm/models/glm5next/nvidia/mhc_prefill_sharding.py:/usr/local/lib/python3.12/dist-packages/vllm/models/glm5next/nvidia/mhc_prefill_sharding.py:ro -v $HOME/tp4/experiments/e03/overrides/vllm/models/glm5next/nvidia/model.py:/usr/local/lib/python3.12/dist-packages/vllm/models/glm5next/nvidia/model.py:ro -e VLLM_ADAPTIVE_K_RESPECT_DRAFT_BUDGET=1'
EXTRA_VLLM_ARGS="--kv-cache-memory-bytes=16106127360 --attention-backend B12X --moe-backend triton --linear-backend triton --scheduler-cls adaptive_k_scheduler.AdaptiveKScheduler"
