# Return from the E36 default to E31-MB: the acceptance-EMA verify length and a BF16 lm_head,
# without the E36 runner and module or the E35 speculator and scheduler copy. Source after
# cluster.env and use the same TP4_ENV for the whole window, including down. It swaps the E35
# scheduler mount back to the E31-MB scheduler and removes exactly the E36 runner and module
# mounts, the E35 speculator and policy mounts and the four E35/E36 variables; it refuses any other E35 form, --volume/--mount/--env-file forms and a second
# scheduler mount, so the launcher command equals the E31-MB command
# on all four ranks. Without a restart, the policy file alone can return the verify length to
# the acceptance EMA (see cluster.env.example).
_E3R_DIR='$HOME/tp4/experiments/e03/e35-runner-k'
_E3R_VLLM=/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu
_E3R_SCHED_E35="$_E3R_DIR/adaptive_k_scheduler.py:/opt/tp4/adaptive_k_scheduler.py:ro"
_E3R_SCHED_MB='$HOME/tp4/experiments/e03/draft-budget/adaptive_k_scheduler.py:/opt/tp4/adaptive_k_scheduler.py:ro'
_E3R_DROP=("\$HOME/tp4/experiments/e03/e36-lm-head-w8a16/model_runner.py:$_E3R_VLLM/model_runner.py:ro"
           "\$HOME/tp4/experiments/e03/e36-lm-head-w8a16/e36_lm_head_w8a16.py:/usr/local/lib/python3.12/dist-packages/vllm/models/glm5next/nvidia/e36_lm_head_w8a16.py:ro"
           VLLM_E36_LM_HEAD_W8A16=1 VLLM_E36_KEEP_BF16=0
           "$_E3R_DIR/speculator.py:$_E3R_VLLM/spec_decode/dflash2/speculator.py:ro"
           "$_E3R_DIR/policy.flag:/tmp/glm53-e35-policy:ro"
           VLLM_E35_ENABLE=1 VLLM_E35_POLICY_FLAG=/tmp/glm53-e35-policy)
if [[ "${EXTRA_DOCKER_ENV-}" == *$'\n'* ]]; then
  echo "E31-MB return refuses multiline Docker arguments" >&2
  unset _E3R_DIR _E3R_VLLM _E3R_SCHED_E35 _E3R_SCHED_MB _E3R_DROP
  return 1
fi
read -r -a _E3R_WORDS <<<"${EXTRA_DOCKER_ENV-}"
_E3R_OUT= _E3R_SCHED=0 _E3R_HITS=() _E3R_INDEX=0 _E3R_OPAQUE=0
for _E3R_WORD in "${_E3R_DROP[@]}"; do _E3R_HITS+=(0); done
while [ "$_E3R_INDEX" -lt "${#_E3R_WORDS[@]}" ]; do
  _E3R_WORD=${_E3R_WORDS[$_E3R_INDEX]}
  _E3R_NEXT=${_E3R_WORDS[$((_E3R_INDEX + 1))]-}
  case "$_E3R_WORD" in
    --volume|--volume=*|--mount|--mount=*|--env-file|--env-file=*) _E3R_OPAQUE=$((_E3R_OPAQUE + 1)) ;;
  esac
  if { [ "$_E3R_WORD" = -v ] || [ "$_E3R_WORD" = -e ]; } && [ -n "$_E3R_NEXT" ]; then
    _E3R_MATCH=-1
    for _E3R_I in "${!_E3R_DROP[@]}"; do
      [ "$_E3R_NEXT" = "${_E3R_DROP[$_E3R_I]}" ] && _E3R_MATCH=$_E3R_I
    done
    if [ "$_E3R_MATCH" -ge 0 ]; then
      _E3R_HITS[$_E3R_MATCH]=$((_E3R_HITS[$_E3R_MATCH] + 1))
      _E3R_INDEX=$((_E3R_INDEX + 2)); continue
    fi
    if [ "$_E3R_WORD" = -v ] && [ "$_E3R_NEXT" = "$_E3R_SCHED_E35" ]; then
      _E3R_SCHED=$((_E3R_SCHED + 1))
      _E3R_OUT+="${_E3R_OUT:+ }-v $_E3R_SCHED_MB"
      _E3R_INDEX=$((_E3R_INDEX + 2)); continue
    fi
  fi
  _E3R_OUT+="${_E3R_OUT:+ }$_E3R_WORD"
  _E3R_INDEX=$((_E3R_INDEX + 1))
done
_E3R_BAD=0
[ "$_E3R_SCHED" = 1 ] || _E3R_BAD=1
[ "$_E3R_OPAQUE" = 0 ] || _E3R_BAD=1
# Exactly one mount may target the adaptive scheduler after the swap.
read -r -a _E3R_WORDS <<<"$_E3R_OUT"
_E3R_TARGETS=0
for _E3R_I in "${!_E3R_WORDS[@]}"; do
  if [ "${_E3R_WORDS[$_E3R_I]}" = -v ]; then
    case "${_E3R_WORDS[$((_E3R_I + 1))]-}" in
      *:/opt/tp4/adaptive_k_scheduler.py|*:/opt/tp4/adaptive_k_scheduler.py:*) _E3R_TARGETS=$((_E3R_TARGETS + 1)) ;;
    esac
  fi
done
[ "$_E3R_TARGETS" = 1 ] || _E3R_BAD=1
for _E3R_I in "${!_E3R_HITS[@]}"; do [ "${_E3R_HITS[$_E3R_I]}" = 1 ] || _E3R_BAD=1; done
case " $_E3R_OUT " in *e35-runner-k*|*VLLM_E35_*|*glm53-e35-policy*|*e36-lm-head-w8a16*|*VLLM_E36_*|*e36_lm_head_w8a16*) _E3R_BAD=1 ;; esac
if [ "$_E3R_BAD" != 0 ]; then
  echo "E31-MB return requires exactly the default E35 scheduler, runner, speculator and policy selection" >&2
  unset _E3R_DIR _E3R_VLLM _E3R_SCHED_E35 _E3R_SCHED_MB _E3R_DROP _E3R_WORDS _E3R_OUT _E3R_SCHED \
    _E3R_HITS _E3R_INDEX _E3R_WORD _E3R_NEXT _E3R_MATCH _E3R_I _E3R_BAD _E3R_OPAQUE _E3R_TARGETS
  return 1
fi
EXTRA_DOCKER_ENV=$_E3R_OUT
unset _E3R_DIR _E3R_VLLM _E3R_SCHED_E35 _E3R_SCHED_MB _E3R_DROP _E3R_WORDS _E3R_OUT _E3R_SCHED \
  _E3R_HITS _E3R_INDEX _E3R_WORD _E3R_NEXT _E3R_MATCH _E3R_I _E3R_BAD _E3R_OPAQUE _E3R_TARGETS
