# Return from the E36 default to the 2026-09-29 memory-bounded recipe, whose SparkCache store
# has no disk limit, whose verify length follows the acceptance EMA alone and whose lm_head is
# BF16. Source after cluster.env and use the same TP4_ENV for the whole window, including down.
# It removes exactly the default's E36 and E35 selections (as operational-20260930-e31-mb.env
# does) and its two
# SparkCache disk-capacity assignments, and refuses any other form of either, --volume/--mount/
# --env-file forms and a second scheduler mount, so the launcher
# command equals the memory-bounded command on all four ranks. For a complete non-site
# rollback use operational-20260929-sparkcache-protected.env instead.
_MBR_DIR='$HOME/tp4/experiments/e03/e35-runner-k'
_MBR_VLLM=/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu
_MBR_SCHED_E35="$_MBR_DIR/adaptive_k_scheduler.py:/opt/tp4/adaptive_k_scheduler.py:ro"
_MBR_SCHED_MB='$HOME/tp4/experiments/e03/draft-budget/adaptive_k_scheduler.py:/opt/tp4/adaptive_k_scheduler.py:ro'
_MBR_DROP=("\$HOME/tp4/experiments/e03/e36-lm-head-w8a16/model_runner.py:$_MBR_VLLM/model_runner.py:ro"
           "\$HOME/tp4/experiments/e03/e36-lm-head-w8a16/e36_lm_head_w8a16.py:/usr/local/lib/python3.12/dist-packages/vllm/models/glm5next/nvidia/e36_lm_head_w8a16.py:ro"
           VLLM_E36_LM_HEAD_W8A16=1 VLLM_E36_KEEP_BF16=0
           "$_MBR_DIR/speculator.py:$_MBR_VLLM/spec_decode/dflash2/speculator.py:ro"
           "$_MBR_DIR/policy.flag:/tmp/glm53-e35-policy:ro"
           VLLM_E35_ENABLE=1 VLLM_E35_POLICY_FLAG=/tmp/glm53-e35-policy
           SPARK_CONTEXT_CACHE_MAX_BYTES=214748364800
           SPARK_CONTEXT_CACHE_LOW_WATERMARK_BYTES=171798691840)
_MBR_CLEAN() {
  unset _MBR_DIR _MBR_VLLM _MBR_SCHED_E35 _MBR_SCHED_MB _MBR_DROP _MBR_WORDS _MBR_OUT \
    _MBR_SCHED _MBR_HITS _MBR_INDEX _MBR_WORD _MBR_NEXT _MBR_MATCH _MBR_I _MBR_BAD _MBR_OPAQUE _MBR_TARGETS
  unset -f _MBR_CLEAN
}
if [[ "${EXTRA_DOCKER_ENV-}" == *$'\n'* ]]; then
  echo "memory-bounded return refuses multiline Docker arguments" >&2
  _MBR_CLEAN
  return 1
fi
read -r -a _MBR_WORDS <<<"${EXTRA_DOCKER_ENV-}"
_MBR_OUT= _MBR_SCHED=0 _MBR_HITS=() _MBR_INDEX=0 _MBR_OPAQUE=0
for _MBR_WORD in "${_MBR_DROP[@]}"; do _MBR_HITS+=(0); done
while [ "$_MBR_INDEX" -lt "${#_MBR_WORDS[@]}" ]; do
  _MBR_WORD=${_MBR_WORDS[$_MBR_INDEX]}
  _MBR_NEXT=${_MBR_WORDS[$((_MBR_INDEX + 1))]-}
  case "$_MBR_WORD" in
    --volume|--volume=*|--mount|--mount=*|--env-file|--env-file=*) _MBR_OPAQUE=$((_MBR_OPAQUE + 1)) ;;
  esac
  if { [ "$_MBR_WORD" = -v ] || [ "$_MBR_WORD" = -e ]; } && [ -n "$_MBR_NEXT" ]; then
    _MBR_MATCH=-1
    for _MBR_I in "${!_MBR_DROP[@]}"; do
      [ "$_MBR_NEXT" = "${_MBR_DROP[$_MBR_I]}" ] && _MBR_MATCH=$_MBR_I
    done
    if [ "$_MBR_MATCH" -ge 0 ]; then
      _MBR_HITS[$_MBR_MATCH]=$((_MBR_HITS[$_MBR_MATCH] + 1))
      _MBR_INDEX=$((_MBR_INDEX + 2)); continue
    fi
    if [ "$_MBR_WORD" = -v ] && [ "$_MBR_NEXT" = "$_MBR_SCHED_E35" ]; then
      _MBR_SCHED=$((_MBR_SCHED + 1))
      _MBR_OUT+="${_MBR_OUT:+ }-v $_MBR_SCHED_MB"
      _MBR_INDEX=$((_MBR_INDEX + 2)); continue
    fi
  fi
  _MBR_OUT+="${_MBR_OUT:+ }$_MBR_WORD"
  _MBR_INDEX=$((_MBR_INDEX + 1))
done
_MBR_BAD=0
[ "$_MBR_SCHED" = 1 ] || _MBR_BAD=1
[ "$_MBR_OPAQUE" = 0 ] || _MBR_BAD=1
# Exactly one mount may target the adaptive scheduler after the swap.
read -r -a _MBR_WORDS <<<"$_MBR_OUT"
_MBR_TARGETS=0
for _MBR_I in "${!_MBR_WORDS[@]}"; do
  if [ "${_MBR_WORDS[$_MBR_I]}" = -v ]; then
    case "${_MBR_WORDS[$((_MBR_I + 1))]-}" in
      *:/opt/tp4/adaptive_k_scheduler.py|*:/opt/tp4/adaptive_k_scheduler.py:*) _MBR_TARGETS=$((_MBR_TARGETS + 1)) ;;
    esac
  fi
done
[ "$_MBR_TARGETS" = 1 ] || _MBR_BAD=1
for _MBR_I in "${!_MBR_HITS[@]}"; do [ "${_MBR_HITS[$_MBR_I]}" = 1 ] || _MBR_BAD=1; done
case " $_MBR_OUT " in
  *e35-runner-k*|*VLLM_E35_*|*glm53-e35-policy*|*e36-lm-head-w8a16*|*VLLM_E36_*|*e36_lm_head_w8a16*|\
  *SPARK_CONTEXT_CACHE_MAX_BYTES*|\
  *SPARK_CONTEXT_CACHE_LOW_WATERMARK_BYTES*|*SPARK_CONTEXT_CACHE_TTL_SECONDS*) _MBR_BAD=1 ;;
esac
if [ "$_MBR_BAD" != 0 ]; then
  echo "memory-bounded return requires exactly the default E35 selection and SparkCache disk-capacity pair" >&2
  _MBR_CLEAN
  return 1
fi
EXTRA_DOCKER_ENV=$_MBR_OUT
_MBR_CLEAN
