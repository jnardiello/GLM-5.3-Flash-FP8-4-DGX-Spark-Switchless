# Housekeeping
.DS_Store
__pycache__/
*.pyc
.ruff_cache/
.claude/settings.local.json

# Internal working documents; retained locally, excluded from public documentation.
/docs/internal/
# Keep legacy root locations private if restored from an older checkout or archive.
/HANDOVER.md
/OPTIMIZATION-PLAN.md
/E09-ROOT-CAUSE-ANALYSIS-2026-09-17.md
/E09-QUALIFICATION-2026-09-17.md
/OPERATIONS-HISTORY.md

# Native Rigmark receipts remain local; portable extracts are published separately.
/docs/rigmark_reports/*
!/docs/rigmark_reports/README.md

# --- Site configuration: created by the user from public templates, never committed.
/cluster.env
# Per-node netplan directories (one per alias). The template and the shared/common
# material stay tracked.
scripts/node/etc/*/
!scripts/node/etc/common/
!scripts/node/etc/default/
scripts/node/etc/common/99-tp4-nopasswd
scripts/node/tp4-autostart.service
scripts/node/ssh-config
scripts/mirror-private-terms.txt
.claude/

# SparkCache/SIRCL: the payload is tracked under third_party/. Here only the portable
# SHA-256 manifests and the repository's own kv-transfer-config.json are tracked; local
# operator copies stay out, and sircl/site/ plus sircl/SHA256SUMS.site hold this site's
# generated per-rank peer/GID files and stay local.
/scripts/node/sparkcache/*
!/scripts/node/sparkcache/kv-transfer-config.json
!/scripts/node/sparkcache/SHA256SUMS
/scripts/node/sircl/*
!/scripts/node/sircl/SHA256SUMS

# Local mirror tooling stays outside the public repository.
/scripts/mirror-snapshot.sh
/scripts/mirror-allow.txt
/scripts/mirror-private-terms.example
