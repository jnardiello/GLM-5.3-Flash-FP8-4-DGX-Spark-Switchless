  "experiment_id": "2026-09-30-e32-prefill-switches",
  "title": "E32: runtime switches for the eager-prefill allocator trim and the 6,912-token step cap",
  "outcome": "discard",
  "outcome_detail": "Owner decision after the A-P-P-A suites: trim mode `new` lowers cold-prefill TTFT by 0.8-1.8% but moves the allocator reclaim to the start of the next request, which slows cached replays by 3-4%; agentic sessions are replay-heavy. The step-cap switches had no measurable effect. The memory-bounded default (trim before every eager prefill step, 6,912-token cap) is unchanged; the overlay is not kept in the tree.",
  "reference": {
    "operational_identity": "2026-09-29-memory-bounded",
    "operational_identity_sha256": "a38d6725b1bbeadac47e33e7a20e6bb8809948b2dff48b3db6ee5d8bad48ed1f",
    "performance_baseline_id": "2026-09-28-e31",
    "comparison": "same-load arm A (the default's behaviour)"
  },
  "candidate": {
    "change": "Flag-file switches over the memory-bounded default, re-read at most every 0.5 s: trim `1` (before every eager prefill step over 72 tokens, the default), `0` (off), `new` (only on steps that schedule a new request) or `pressure:<MiB>` (only below that MemAvailable); cap `6912` (default), `0` (off) or `solo` (off while at most one request is active). Invalid or missing flags fall back to the startup behaviour.",
    "source_sha256": {
